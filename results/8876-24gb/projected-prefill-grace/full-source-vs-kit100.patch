+            try { (void)ninfer::runtime::cuda_graph_allowance_override(); }
+            catch (const std::invalid_argument&) { return 0; }
+            throw std::runtime_error("invalid Graph budget accepted");
+        }
+        const bool cold = mode == "cold";
+        if (ninfer::runtime::cold_request_state_enabled() != cold ||
+            Slots::state_slot_count(16) != (cold ? 16 : 32) ||
+            Slots::current_state_slot(15,16) != 15 ||
+            Slots::turn_checkpoint_state_slot(15,16) != (cold ? -1 : 31))
+            throw std::runtime_error("state role mapping mismatch");
+        try { (void)Slots::turn_checkpoint_state_slot(16,16); return 1; }
+        catch (const std::out_of_range&) {}
+        try { (void)Slots::state_slot_count(0); return 1; }
+        catch (const std::invalid_argument&) {}
+        const auto budget = ninfer::runtime::cuda_graph_allowance_override();
+        if (!budget || *budget != (256ULL << 20)) throw std::runtime_error("Graph budget mismatch");
