+int run(int k) {
+    constexpr int n = 5120, maximum_t = 16;
+    auto packed = tst::quantized_weight::make_patterned_weight(
+        QType::Q5G64_F16S, n, k, 739U,
+        {tst::quantized_weight::RowSplitScalePattern::Small,
+         tst::quantized_weight::RowSplitCodePattern::Hashed});
+    std::vector<float> activation(k * maximum_t), residual(n * maximum_t);
+    tst::fill_uniform(activation, 20261019U, -2.f, 2.f);
+    tst::fill_uniform(residual, 20261020U, -8.f, 8.f);
+    tst::round_to_bf16(activation);
+    tst::round_to_bf16(residual);
+    std::vector<std::uint16_t> x(activation.size()), initial(residual.size());
+    for (size_t i = 0; i < x.size(); ++i) x[i] = tst::f32_to_bf16(activation[i]);
+    for (size_t i = 0; i < initial.size(); ++i) initial[i] = tst::f32_to_bf16(residual[i]);
+    tst::GuardedDeviceBuffer dx(x.size()*2), dw(packed.payload.size()), source(initial.size()*2), out(initial.size()*2);
+    dx.copy_from_host(x.data(), dx.bytes());
+    dw.copy_from_host(packed.payload.data(), dw.bytes());
+    source.copy_from_host(initial.data(), source.bytes());
+    const auto weight = packed.device_weight(dw.data());
+    WorkspaceArena workspace(std::max<size_t>(256, ops::linear_add_workspace_capacity_bytes(QType::Q5G64_F16S,n,k,1,maximum_t)));
+    cudaStream_t stream{};
+    tst::cuda_check(cudaStreamCreateWithFlags(&stream,cudaStreamNonBlocking),"create stream");
