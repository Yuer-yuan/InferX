+            {.vision=false, .speculative=ninfer::SpeculativeBackend::Mtp,
+             .proposal_head=ninfer::ProposalHead::Optimized});
+        std::size_t legacy_bytes = 0, legacy_count = 0;
+        for (const auto& item : plan.materialization.device_objects) {
+            const auto& object = reader.objects().at(item.object.index);
+            const auto name = ninfer::artifact::object_name(object);
+            if (name.starts_with("text/layers/") &&
+                (name.ends_with("/gdn/query_key") || name.ends_with("/gdn/value_z") ||
+                 name.ends_with("/attention/query_key") || name.ends_with("/attention/gate_value"))) {
+                ++legacy_count;
+                legacy_bytes += reader.payload(object).data.size();
+            }
+        }
+        if (legacy_count != (omitted ? 0U : 128U) ||
+            legacy_bytes != (omitted ? 0ULL : 3213885440ULL))
+            throw std::runtime_error("wrong original input device payload set");
