--- artifacts/8876-24gb-kit100/source/src/runtime/engine/slo_projected_prefill_grace.h	1970-01-01 08:00:00.000000000 +0800
+++ artifacts/8876-24gb-projected-grace/source/src/runtime/engine/slo_projected_prefill_grace.h	2026-10-19 08:48:10.407711519 +0800
@@ -0,0 +1,51 @@
+#pragma once
+
+#include <cmath>
+#include <cstdlib>
+#include <stdexcept>
+#include <string_view>
+
+namespace ninfer::runtime {
+
+inline bool parse_projected_prefill_grace(const char* value) {
+    if (!value || std::string_view(value) == "0") { return false; }
+    if (std::string_view(value) == "1") { return true; }
+    throw std::invalid_argument("NINFER_SCHED_PROJECTED_PREFILL_GRACE supports 0/1");
+}
+
+inline bool projected_prefill_grace_enabled() {
+    static const bool enabled = parse_projected_prefill_grace(
+        std::getenv("NINFER_SCHED_PROJECTED_PREFILL_GRACE"));
+    return enabled;
+}
+
+inline void validate_projected_prefill_grace(bool enabled, bool completion_queue,
+                                           bool expired_grace) {
+    if (enabled && (!completion_queue || !expired_grace)) {
+        throw std::invalid_argument(
+            "projected prefill grace requires completion_queue and expired prefill grace");
+    }
+}
+
+// Work includes every FCFS predecessor. The prediction uses the external target,
+// restoring the existing internal reserve, and does not change any Request.
+// The existing expired policy handles [original, original+10000); both policies
+// always derive their bound from the same immutable original deadline.
+inline double projected_prefill_scheduling_deadline(
+    bool enabled, double now, double original, double cumulative_work, double margin) {
+    if (!enabled || !std::isfinite(now) || now < 0 || !std::isfinite(original) ||
+        original < 0 || now >= original || !std::isfinite(cumulative_work) ||
+        cumulative_work < 0 || !std::isfinite(margin) || margin < 0) {
+        return original;
+    }
+    const double earliest = now + cumulative_work;
+    const double external = original + margin;
+    const double end = original + 10000.0;
+    if (!std::isfinite(earliest) || !std::isfinite(external) || !std::isfinite(end) ||
+        earliest <= external) {
+        return original;
+    }
+    return end;
+}
+
+} // namespace ninfer::runtime
