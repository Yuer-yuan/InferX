+#pragma once
+
+#include "runtime/engine/slo_prefill_queue_policy.h"
+
+namespace ninfer::runtime {
+inline bool parse_expired_completion_soft_pf(const char* value) {
+    if (value == nullptr || std::string_view(value) == "0") { return false; }
+    if (std::string_view(value) == "1") { return true; }
+    throw std::invalid_argument("NINFER_SCHED_EXPIRED_COMPLETION_SOFT_PF supports 0/1");
+}
+
+inline bool expired_completion_soft_pf_enabled() {
+    static const bool enabled = parse_expired_completion_soft_pf(
+        std::getenv("NINFER_SCHED_EXPIRED_COMPLETION_SOFT_PF"));
+    return enabled;
+}
+
+// At most one additional soft PF unit between successful decode services.
+// Ordinary/hard PF and control-only work never unlock the credit.
+class ExpiredCompletionSoftPfCadence {
+public:
+    [[nodiscard]] bool available() const { return !decode_due_; }
+    void record_completed_prefill(bool was_override, unsigned processed_tokens) {
+        if (was_override && processed_tokens) { decode_due_ = true; }
+    }
+    void record_completed_decode(unsigned noncancelled_committed_tokens) {
+        if (noncancelled_committed_tokens) { decode_due_ = false; }
+    }
+private:
+    bool decode_due_ = false;
+};
+
+// The caller has already made the ORIGINAL all-row/all-predecessor decision.
+// Returning false preserves that decision exactly, including hard-PF conflicts.
+[[nodiscard]] inline bool allow_expired_completion_soft_pf(
+    bool enabled, CompletionChoice original, double now_ms,
+    std::span<const PrefillDemandView> prefills, double next_chunk_ms,
+    BatchCostBin decode, std::span<const CompletionBudgetView> decodes,
+    const ExpiredCompletionSoftPfCadence& cadence) {
+    if (!enabled || original != CompletionChoice::Decode || !cadence.available() ||
+        prefills.empty() || decodes.empty() || !decode.observations ||
+        !std::isfinite(now_ms) || now_ms < 0 ||
+        !std::isfinite(next_chunk_ms) || next_chunk_ms <= 0 ||
+        !std::isfinite(decode.round_ms) || decode.round_ms <= 0 ||
+        !std::isfinite(decode.tokens_per_row_round) || decode.tokens_per_row_round <= 0) {
+        return false;
+    }
+    double cumulative_ms = 0;
+    for (const auto& p : prefills) {
+        if (!std::isfinite(p.deadline_ms) || !std::isfinite(p.remaining_ms) ||
+            p.remaining_ms < 0) { return false; }
+        cumulative_ms += p.remaining_ms;
+        if (!std::isfinite(cumulative_ms) ||
+            !std::isfinite(p.deadline_ms - cumulative_ms)) { return false; }
+    }
+    if (next_chunk_ms > prefills.front().remaining_ms) { return false; }
+    const auto boundary = fcfs_prefill_boundary(prefills);
+    // Use the same arithmetic as the original whole-completion hard boundary.
+    const double pf_laxity = boundary.effective_front_deadline_ms - now_ms -
+                             prefills.front().remaining_ms;
+    if (!std::isfinite(pf_laxity) || pf_laxity <= decode.round_ms) { return false; }
+
+    bool has_expired = false;
+    bool has_unexpired = false;
+    double min_unexpired_laxity = std::numeric_limits<double>::infinity();
+    for (const auto& d : decodes) {
+        if (!d.committed_tokens || !d.remaining_tokens ||
+            d.remaining_tokens > std::numeric_limits<unsigned>::max() - d.committed_tokens ||
+            !std::isfinite(d.first_token_ms) || d.first_token_ms < 0 ||
+            d.first_token_ms > now_ms) { return false; }
+        const unsigned total = d.committed_tokens + d.remaining_tokens;
+        const double deadline = d.first_token_ms + (total - 1) * 40.0;
+        const double work = completion_remaining_rounds(d, decode.tokens_per_row_round) *
+                            decode.round_ms;
+        const double laxity = deadline - now_ms - work;
+        if (!std::isfinite(deadline) || !std::isfinite(work) || !std::isfinite(laxity)) {
+            return false;
+        }
+        // A negative forecast laxity ALONE must never discard an active deadline.
+        if (deadline <= now_ms) { has_expired = true; }
+        else {
+            has_unexpired = true;
+            min_unexpired_laxity = std::min(min_unexpired_laxity, laxity);
+        }
+    }
+    if (!has_expired || !has_unexpired || min_unexpired_laxity < next_chunk_ms) {
+        return false;
+    }
+    const double after_pf = min_unexpired_laxity - next_chunk_ms;
+    const double after_decode = pf_laxity - decode.round_ms;
+    return std::isfinite(after_pf) && std::isfinite(after_decode) && after_pf >= after_decode;
+}
