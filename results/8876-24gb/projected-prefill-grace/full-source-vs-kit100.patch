+// Request-owned baseline acceptance estimate. Successful lookup observations are
+// not evidence that baseline MTP recovered; failed lookups require fresh samples.
+class PromptLookupYieldHistory {
+public:
+    bool eligible()const noexcept{return count_==8&&sum_<=8;}
+    unsigned samples()const noexcept{return count_;}
+    unsigned accepted_sum()const noexcept{return sum_;}
+    void reset()noexcept{accepted_={};count_=sum_=next_=0;}
+    void record(unsigned committed_drafts,bool lookup_override,unsigned proposed_drafts){
+        if(committed_drafts>3||proposed_drafts>3||
+           (lookup_override&&(proposed_drafts==0||committed_drafts>proposed_drafts)))
+            throw std::invalid_argument("invalid K3 lookup yield feedback");
+        if(lookup_override){if(committed_drafts!=proposed_drafts)reset();return;}
+        if(count_==8)sum_-=accepted_[next_];else ++count_;
+        accepted_[next_]=static_cast<std::uint8_t>(committed_drafts);sum_+=committed_drafts;next_=(next_+1)%8;
+    }
+private:
+    std::array<std::uint8_t,8> accepted_{};
+    unsigned count_=0,sum_=0,next_=0;
+};
