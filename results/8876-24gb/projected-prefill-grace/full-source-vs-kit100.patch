+#include "runtime/engine/slo_expired_completion_soft_pf.h"
+#include "runtime/engine/slo_bounded_decode_membership.h"
+
+#include <cassert>
+#include <iostream>
+#include <vector>
+
+namespace {
+using namespace ninfer::runtime;
+constexpr double now = 10000;
+constexpr BatchCostBin cost{40, 2, 1};
+constexpr double nan = std::numeric_limits<double>::quiet_NaN();
+constexpr double inf = std::numeric_limits<double>::infinity();
+const std::vector<PrefillDemandView> queue{{12000, 1000}};
+const std::vector<CompletionBudgetView> rows{{6040, 90, 10, 0}, {8040, 90, 10, 0}};
+
+bool allow(const std::vector<CompletionBudgetView>& r,
+           const std::vector<PrefillDemandView>& q = queue, BatchCostBin bin = cost,
+           double time = now, double chunk = 200,
+           const ExpiredCompletionSoftPfCadence& cadence = {}) {
+    const auto original = choose_fcfs_completion_unit(time, q, chunk, bin, 40, r);
+    return allow_expired_completion_soft_pf(true, original, time, q, chunk, bin, r, cadence);
+}
+
+void contracts() {
+    const auto original = choose_fcfs_completion_unit(now, queue, 200, cost, 40, rows);
+    assert(original == CompletionChoice::Decode);
+    assert(allow(rows)); // now == first + 99*40 is genuinely elapsed.
+    auto changed = rows;
+    changed[0].first_token_ms += .001;
+    assert(!allow(changed)); // Negative forecast laxity, but deadline not elapsed.
+    changed = rows;
+    changed[0].first_token_ms -= .001;
+    assert(allow(changed));
+    changed = rows;
+    changed[1].first_token_ms = 6040;
+    assert(!allow(changed)); // ALL overdue: never turn an empty min into +infinity.
+    changed = rows;
+    changed[0] = changed[1];
+    assert(!allow(changed)); // No overdue: preserve original choice.
+    changed = rows;
+    changed[1].first_token_ms = 7000;
+    assert(!allow(changed)); // Unexpired can spare200, but filtered comparison still Decode.
+    changed[1].first_token_ms = 6400;
+    assert(!allow(changed)); // Unexpired cannot spare the chunk.
+
+    for (double slack : {-10., 0., 40.}) {
+        const std::vector<PrefillDemandView> hard{{now + 1000 + slack, 1000}};
+        const auto old = choose_fcfs_completion_unit(now, hard, 200, cost, 40, rows);
+        assert(old == CompletionChoice::PrefillDeadlineConflict);
+        assert(!allow(rows, hard));
+    }
+    // A later tight predecessor remains in the PF prefix; do not use just the head.
+    assert(!allow(rows, {{12000, 1000}, {12040, 1000}}));
+    assert(!allow(rows, {}));
+    assert(!allow({}));
+    assert(!allow(rows, queue, {40, 2, 0}));
+    for (double bad : {nan, inf, -inf, -1., 0.}) {
+        assert(!allow(rows, queue, {bad, 2, 1}));
+        assert(!allow(rows, queue, {40, bad, 1}));
+        assert(!allow(rows, queue, cost, now, bad));
+    }
+    for (double bad : {nan, inf, -inf, -1.}) {
+        assert(!allow(rows, queue, cost, bad));
+    }
+    assert(!allow(rows, queue, cost, now, 1001));
+    assert(!allow(rows, {{nan, 1000}}));
+    assert(!allow(rows, {{12000, inf}}));
+    assert(!allow(rows, {{12000, -1}}));
+    assert(!allow(rows, {{12000, 1000}, {inf, 1000}}));
+    for (double bad : {nan, inf, -inf, -1., now + 1}) {
+        changed = rows;
+        changed[1].first_token_ms = bad;
+        assert(!allow(changed));
+    }
+    changed = rows;
+    changed[0].committed_tokens = 0;
+    assert(!allow(changed));
+    changed = rows;
+    changed[0].remaining_tokens = 0;
+    assert(!allow(changed));
+    changed = rows;
+    changed[0].remaining_tokens = std::numeric_limits<unsigned>::max();
+    assert(!allow(changed));
+    changed = rows;
+    changed[1].first_token_ms = 7400;
+    assert(allow(changed));
+    changed[1].committed_decode_rounds = 1000;
+    assert(!allow(changed)); // Preserve own-yield max, do not just use batch yield.
+    assert(!allow_expired_completion_soft_pf(false, original, now, queue, 200, cost, rows, {}));
+    assert(!allow_expired_completion_soft_pf(false, original, nan, {}, nan, {}, {}, {}));
+    assert(!allow_expired_completion_soft_pf(true, CompletionChoice::Prefill, now, queue,
+                                           200, cost, rows, {}));
+
+    ExpiredCompletionSoftPfCadence cadence;
+    assert(cadence.available());
+    assert(allow(rows, queue, cost, now, 200, cadence));
+    assert(cadence.available()); // A pure proposal cannot consume a credit.
+    cadence.record_completed_prefill(true, 0); // cancelled/control-only admission.
+    cadence.record_completed_prefill(false, 2048); // ordinary/hard PF.
+    assert(cadence.available());
+    cadence.record_completed_prefill(true, 2048);
+    assert(!cadence.available());
+    assert(!allow(rows, queue, cost, now, 200, cadence));
+    cadence.record_completed_prefill(false, 2048);
+    cadence.record_completed_prefill(true, 2048);
+    cadence.record_completed_decode(0); // empty/all-cancelled round.
+    assert(!cadence.available());
+    assert(!allow(rows, queue, cost, now, 200, cadence));
+    cadence.record_completed_decode(1); // actual committed, noncancelled token.
+    assert(cadence.available());
+    assert(allow(rows, queue, cost, now, 200, cadence));
+
+    // Existing bounded ranking cannot omit an actually overdue row: omitted
+    // rows must have positive reserve. No membership policy change is necessary.
+    std::vector<BoundedDecodeView> views;
+    for (unsigned i = 0; i < 14; ++i) {
+        views.push_back({i, i == 13 ? rows[0] : rows[1], true});
+    }
+    const auto subset = choose_bounded_decode_membership(true, now, cost, views, {});
+    assert(subset.use_subset);
+    assert(std::find(subset.indices.begin(), subset.indices.end(), 13) != subset.indices.end());
+    for (unsigned i = 0; i < 10; ++i) { views[i].completion = rows[0]; }
+    assert(!choose_bounded_decode_membership(true, now, cost, views, {}).use_subset);
+}
+
+void set_flag(const char* value) {
+#ifdef _WIN32
+    assert(_putenv_s("NINFER_SCHED_EXPIRED_COMPLETION_SOFT_PF", value ? value : "") == 0);
+#else
+    if (value) { assert(setenv("NINFER_SCHED_EXPIRED_COMPLETION_SOFT_PF", value, 1) == 0); }
+    else { assert(unsetenv("NINFER_SCHED_EXPIRED_COMPLETION_SOFT_PF") == 0); }
+#endif
+}
+} // namespace
+
+int main(int argc, char** argv) {
+    using namespace ninfer::runtime;
+    if (argc > 1 && std::string_view(argv[1]) == "invalid") {
+        for (const char* bad : {"", "2", "-1", "1 ", "true", "nan"}) {
+            bool rejected = false;
+            try { (void)parse_expired_completion_soft_pf(bad); }
+            catch (const std::invalid_argument&) { rejected = true; }
+            assert(rejected);
+        }
+        set_flag("invalid");
+        bool rejected = false;
+        try { (void)expired_completion_soft_pf_enabled(); }
+        catch (const std::invalid_argument&) { rejected = true; }
+        assert(rejected);
+    } else {
+        const char* value = argc > 1 ? argv[1] : nullptr;
+        set_flag(value);
+        const bool expected = value && std::string_view(value) == "1";
+        assert(expired_completion_soft_pf_enabled() == expected);
+        set_flag(expected ? "0" : "1");
+        assert(expired_completion_soft_pf_enabled() == expected); // process frozen.
+        contracts();
+    }
+    std::cout << "expired completion soft PF CPU contracts PASS\n";
+}
