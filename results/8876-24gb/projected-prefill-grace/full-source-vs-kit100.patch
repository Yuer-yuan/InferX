+ }
+ for(double bad:{-1.,double(NAN),double(INFINITY)}){
+  need(expired_prefill_scheduling_deadline(true,bad,10000)==10000,"invalid clock preserves original");
+  double got=expired_prefill_scheduling_deadline(true,10050,bad);need(std::isnan(bad)?std::isnan(got):got==bad,"invalid deadline preserved");
+ }
+ std::array<PrefillDemandView,2> original{{{10000,1000},{10000,1000}}};auto late=original;
+ for(auto&p:late)p.deadline_ms=expired_prefill_scheduling_deadline(true,10050,p.deadline_ms);
+ need(original[0].deadline_ms==10000&&original[1].deadline_ms==10000,"original demands immutable");
+ BatchCostBin bin{50,3,1};std::array<CompletionBudgetView,1>d{{{0,100,412,33}}};
+ // Independent: original latest-start8000, graced18000; completion laxity3490.
+ need(fcfs_prefill_boundary(original).latest_start_ms==8000&&fcfs_prefill_boundary(late).latest_start_ms==18000,"FCFS arithmetic");
+ need(choose_fcfs_completion_unit(10050,original,250,bin,40,d)==CompletionChoice::Prefill,"baseline hard PF");
+ need(choose_fcfs_completion_unit(10050,late,250,bin,40,d)==CompletionChoice::Decode,"grace licenses full decode");
+ auto mixed=original;mixed[1].deadline_ms=13000;for(auto&p:mixed)p.deadline_ms=expired_prefill_scheduling_deadline(true,10050,p.deadline_ms);
+ need(mixed[0].deadline_ms==20000&&mixed[1].deadline_ms==13000&&fcfs_prefill_boundary(mixed).latest_start_ms==11000,"fresh successor retains deadline/order/work");
+ auto old=original;for(auto&p:old)p.deadline_ms=expired_prefill_scheduling_deadline(true,20000,p.deadline_ms);
