@@ -0,0 +1,68 @@
+#pragma once
+#include "runtime/engine/slo_bounded_decode_membership.h"
+
+namespace ninfer::runtime {
+inline bool parse_unexpired_decode_priority(const char* value) {
+    if (value == nullptr || std::string_view(value) == "0") { return false; }
+    if (std::string_view(value) == "1") { return true; }
+    throw std::invalid_argument("NINFER_SCHED_UNEXPIRED_DECODE_PRIORITY supports 0/1");
+}
+inline bool unexpired_decode_priority_enabled() {
+    static const bool enabled = parse_unexpired_decode_priority(
+        std::getenv("NINFER_SCHED_UNEXPIRED_DECODE_PRIORITY"));
+    return enabled;
+}
+inline void validate_unexpired_decode_priority(bool enabled, bool completion_queue,
+                                               bool mtp, unsigned k, unsigned native,
+                                               bool old_bounded) {
+    if (enabled && (!completion_queue || !mtp || k != 3 || native == 0 || native > 16 || old_bounded)) {
+        throw std::invalid_argument(
+            "unexpired decode priority requires completion_queue, MTP K3, native1..16 and bounded membership off");
+    }
+}
+class UnexpiredDecodeCadence {
+public:
+    [[nodiscard]] unsigned subsets_completed() const { return subsets_completed_; }
+    void record_completed_decode(bool subset, unsigned committed_tokens) {
+        if (committed_tokens == 0) { return; }
+        if (!subset) { subsets_completed_ = 0; }
+        else if (subsets_completed_ < 3) { ++subsets_completed_; }
+    }
+private:
+    unsigned subsets_completed_ = 0;
+};
+struct UnexpiredDecodeSelection {
+    bool use_subset = false;
+    std::size_t size = 0;
+    std::array<std::size_t, 16> indices{};
+};
+// The original full-ready chooser must already have selected Decode. No forecast
+// can omit an unexpired row; every fourth positive-token service uses the full snapshot.
+[[nodiscard]] inline UnexpiredDecodeSelection choose_unexpired_decode_membership(
+    bool enabled, double now_ms, std::span<const BoundedDecodeView> ready,
+    const UnexpiredDecodeCadence& cadence) {
+    if (!enabled || cadence.subsets_completed() >= 3 || ready.size() < 2 || ready.size() > 16 ||
+        !std::isfinite(now_ms) || now_ms < 0) { return {}; }
+    UnexpiredDecodeSelection result;
+    for (std::size_t i = 0; i < ready.size(); ++i) {
+        const auto& row = ready[i];
+        const auto& request = row.completion;
+        if (!row.live || row.lane >= 16 || !request.committed_tokens || !request.remaining_tokens ||
+            !std::isfinite(request.first_token_ms) || request.first_token_ms < 0 ||
+            request.first_token_ms > now_ms ||
+            request.remaining_tokens > std::numeric_limits<unsigned>::max() - request.committed_tokens) {
+            return {};
+        }
+        for (std::size_t j = 0; j < i; ++j) {
+            if (ready[j].lane == row.lane) { return {}; }
+        }
+        const unsigned total = request.committed_tokens + request.remaining_tokens;
+        const double deadline = request.first_token_ms + (total - 1) * 40.0;
+        if (!std::isfinite(deadline)) { return {}; }
+        if (deadline > now_ms) { result.indices[result.size++] = i; }
+    }
+    if (result.size == 0 || result.size == ready.size()) { return {}; }
+    result.use_subset = true;
+    return result;
+}
+} // namespace ninfer::runtime
