+namespace ninfer::runtime {
+inline bool parse_expired_prefill_grace(const char* value) {
+ if(value==nullptr||std::string_view(value)=="0")return false;
+ if(std::string_view(value)=="1")return true;
+ throw std::invalid_argument("NINFER_SCHED_EXPIRED_PREFILL_GRACE supports 0/1");
+}
+inline bool expired_prefill_grace_enabled(){
+ static const bool value=parse_expired_prefill_grace(std::getenv("NINFER_SCHED_EXPIRED_PREFILL_GRACE"));return value;
+}
+inline void validate_expired_prefill_grace(bool enabled,bool completion_queue){
+ if(enabled&&!completion_queue)throw std::invalid_argument("expired prefill grace requires completion_queue");
+}
+// Caller always supplies the ORIGINAL absolute deadline from immutable submit time.
+// This never changes a Request or admits/reorders work; the one wall-clock window
+// ends at original+10000 even if no PF was scheduled during it.
+inline double expired_prefill_scheduling_deadline(bool enabled,double now,double original){
+ if(!enabled||!std::isfinite(now)||now<0||!std::isfinite(original)||original<0)return original;
+ const double end=original+10000.0;
+ if(!std::isfinite(end)||now<original||now>=end)return original;
+ return end;
+}
+}
