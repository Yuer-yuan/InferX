+// Frozen before planning. Cold mode reserves no reusable turn-checkpoint state;
+// requests that enable prefix reuse must be rejected before admission.
+inline bool cold_request_state_enabled() {
+    static const bool enabled = [] {
+        const char* value = std::getenv("NINFER_COLD_REQUEST_STATE");
+        if (!value || std::string_view(value) == "0") return false;
+        if (std::string_view(value) == "1") return true;
+        throw std::invalid_argument("NINFER_COLD_REQUEST_STATE must be 0 or 1");
+    }();
+    return enabled;
+}
+
+inline std::optional<std::size_t> cuda_graph_allowance_override() {
+    static const auto bytes = []() -> std::optional<std::size_t> {
+        const char* value = std::getenv("NINFER_CUDA_GRAPH_ALLOWANCE_MB");
+        if (!value) return std::nullopt;
+        const std::string_view text(value);
+        unsigned mib = 0;
+        const auto result = std::from_chars(text.data(), text.data() + text.size(), mib);
+        if (result.ec != std::errc{} || result.ptr != text.data() + text.size() ||
+            mib < 64 || mib > 65536) {
+            throw std::invalid_argument("NINFER_CUDA_GRAPH_ALLOWANCE_MB must be an integer in [64,65536]");
+        }
+        return std::size_t(mib) * 1024U * 1024U;
+    }();
+    return bytes;
+}
+
