@@ -0,0 +1,85 @@
+#pragma once
+#include "runtime/engine/slo_bounded_decode_membership.h"
+
+namespace ninfer::runtime {
+inline bool parse_tpot_recovery(const char* value) {
+    if (!value || std::string_view(value)=="0") return false;
+    if (std::string_view(value)=="1") return true;
+    throw std::invalid_argument("NINFER_SCHED_TPOT_RECOVERY supports 0/1");
+}
+inline bool tpot_recovery_enabled() {
+    static const bool enabled=parse_tpot_recovery(std::getenv("NINFER_SCHED_TPOT_RECOVERY"));
+    return enabled;
+}
+inline void validate_tpot_recovery(bool enabled, bool completion_queue, bool mtp,
+                                  unsigned k, unsigned native, bool own_yield,
+                                  bool old_bounded, bool old_unexpired) {
+    if (enabled && (!completion_queue || !mtp || k!=3 || native==0 || native>16 ||
+                    !own_yield || old_bounded || old_unexpired))
+        throw std::invalid_argument("TPOT recovery requires completion_queue, MTP K3, native1..16, request yield and older membership policies off");
+}
+struct TpotRecoverySelection {
+    bool use_subset=false;
+    std::array<std::size_t,5> indices{};
+};
+
+// Forecasts use committed history and actually observed costs. They are policy
+// estimates, not guarantees; all omitted rows receive the next two full services.
+inline TpotRecoverySelection choose_tpot_recovery_membership(
+    bool enabled, double now_ms, BatchCostBin full, BatchCostBin small,
+    std::span<const BoundedDecodeView> ready, const BoundedDecodeCadence& cadence) {
+    if (!enabled || cadence.full_rounds_due() || ready.size()<10 || ready.size()>16 ||
+        !std::isfinite(now_ms) || now_ms<0 || !full.observations || !small.observations ||
+        !std::isfinite(full.round_ms) || !std::isfinite(small.round_ms) ||
+        small.round_ms<=0 || full.round_ms<=small.round_ms) return {};
+    const double priority_round=(2*full.round_ms+small.round_ms)/3;
+    const double omitted_round=(2*full.round_ms+small.round_ms)/2;
+    if (!std::isfinite(priority_round) || !std::isfinite(omitted_round)) return {};
+    struct Forecast {
+        std::size_t index=0; std::uint32_t lane=0;
+        double tpot=0, normal=0, omitted=0, duration=0;
+        bool mature=false;
+    };
+    std::array<Forecast,16> forecasts{}, candidates{};
+    std::size_t count=0;
+    for (std::size_t i=0;i<ready.size();++i) {
+        const auto& row=ready[i]; const auto& d=row.completion;
+        if (!row.live || row.lane>=16 || !d.committed_tokens || !d.remaining_tokens ||
+            !std::isfinite(d.first_token_ms) || d.first_token_ms<0 || d.first_token_ms>now_ms ||
+            d.remaining_tokens>std::numeric_limits<unsigned>::max()-d.committed_tokens) return {};
+        for (std::size_t j=0;j<i;++j) if (ready[j].lane==row.lane) return {};
+        // Ordinary K3 commits one to four tokens per resolved noncancelled round.
+        if (d.committed_decode_rounds>d.committed_tokens-1 ||
+            (d.committed_tokens>1 && d.committed_decode_rounds<
+             (std::uint64_t(d.committed_tokens)-1+3)/4)) return {};
+        if (d.committed_tokens<33 || d.committed_decode_rounds<8) continue;
+        const double own_yield=double(d.committed_tokens-1)/double(d.committed_decode_rounds);
+        if (!std::isfinite(own_yield) || own_yield<=0 || own_yield>4) return {};
+        const double remaining_rounds=std::ceil(d.remaining_tokens/std::max(1.,own_yield));
+        const double intervals=double(d.committed_tokens)+double(d.remaining_tokens)-1;
+        const double duration=intervals*40.; const double elapsed=now_ms-d.first_token_ms;
+        const double normal=elapsed+remaining_rounds*full.round_ms;
+        const double recovered=elapsed+remaining_rounds*priority_round;
+        const double omitted=elapsed+remaining_rounds*omitted_round;
+        if (!std::isfinite(normal) || !std::isfinite(recovered) || !std::isfinite(omitted)) return {};
+        Forecast f{i,row.lane,normal/intervals,normal,omitted,duration,true};forecasts[i]=f;
+        if (d.remaining_tokens>=64 && recovered<=duration) candidates[count++]=f;
+    }
+    if (count<5) return {};
+    std::sort(candidates.begin(),candidates.begin()+count,[](const Forecast& a,const Forecast& b){
+        return a.tpot!=b.tpot ? a.tpot>b.tpot : a.lane<b.lane;
+    });
+    if (candidates[0].tpot<32.) return {}; // Internal warning, external SLO remains40ms.
+    TpotRecoverySelection result;
+    for (std::size_t i=0;i<5;++i) result.indices[i]=candidates[i].index;
+    std::sort(result.indices.begin(),result.indices.end());
+    for (std::size_t i=0;i<ready.size();++i) {
+        const auto& f=forecasts[i];
+        if (!f.mature || std::find(result.indices.begin(),result.indices.end(),i)!=result.indices.end()) continue;
+        // Protect rows that the current full-service forecast can still finish.
+        // Infeasible/expired rows remain admitted and receive both full services.
+        if (f.normal<=f.duration && f.omitted>f.duration) return {};
+    }
+    result.use_subset=true; return result;
+}
+} // namespace ninfer::runtime
