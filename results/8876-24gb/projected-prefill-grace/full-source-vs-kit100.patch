diff -ru -N '--exclude=*.orig' artifacts/8876-24gb-kit100/source/tests/test_slo_expired_completion_soft_pf.cpp artifacts/8876-24gb-projected-grace/source/tests/test_slo_expired_completion_soft_pf.cpp
