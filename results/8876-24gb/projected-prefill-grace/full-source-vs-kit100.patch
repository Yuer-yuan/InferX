+#include "runtime/engine/slo_prefill_queue_policy.h"
+#include <array>
+#include <iostream>
+
+using namespace ninfer::runtime;
+void need(bool ok, const char* message) {
+    if (!ok) { throw std::runtime_error(message); }
+}
+template<class F> void rejects(F f) {
+    bool caught = false;
+    try { f(); } catch (const std::invalid_argument&) { caught = true; }
+    need(caught, "expected invalid argument");
+}
+void cases() {
+    need(!parse_projected_prefill_grace(nullptr) && !parse_projected_prefill_grace("0") &&
+         parse_projected_prefill_grace("1"), "strict flags");
+    for (auto text : {"", "true", "2", " 1", "1 "}) {
+        rejects([&] { parse_projected_prefill_grace(text); });
+    }
+    for (double shift : {0., 2e10}) {
+        for (double work : {0., 900., 1050., 1051., 5000.}) {
+            const double want = (work > 1050 ? 19900. : 9900.) + shift;
+            need(projected_prefill_scheduling_deadline(true, 9000+shift, 9900+shift,
+                                                       work, 150) == want,
+                 "external equality, reserve and translation");
+            need(projected_prefill_scheduling_deadline(false, 9000+shift, 9900+shift,
+                                                       work, 150) == 9900+shift,
+                 "OFF preserves original");
+        }
+    }
+    for (double bad : {-1., double(NAN), double(INFINITY)}) {
+        need(projected_prefill_scheduling_deadline(true,bad,9900,2000,150)==9900,
+             "invalid now");
+        need(projected_prefill_scheduling_deadline(true,9000,9900,bad,150)==9900,
+             "invalid work");
+        need(projected_prefill_scheduling_deadline(true,9000,9900,2000,bad)==9900,
+             "invalid margin");
+        const double value=projected_prefill_scheduling_deadline(true,9000,bad,2000,150);
+        need(std::isnan(bad) ? std::isnan(value) : value==bad, "invalid original");
+    }
+    need(projected_prefill_scheduling_deadline(true,1e308,1.5e308,1e308,150)==1.5e308,
+         "overflow does not grant grace");
+    for (double now : {9900.,10000.,19899.,19900.,20000.}) {
+        need(projected_prefill_scheduling_deadline(true,now,9900,2000,150)==9900,
+             "projected policy cannot renew expired window");
+        const double want=now<19900 ? 19900 : 9900;
+        need(std::max(projected_prefill_scheduling_deadline(true,now,9900,2000,150),
+                      expired_prefill_scheduling_deadline(true,now,9900))==want,
+             "combined one absolute window");
+    }
+    const std::array<PrefillDemandView,2> original{{{9900,500},{9900,1500}}};
+    auto adjusted=original;
+    double cumulative=0;
+    for (auto& row : adjusted) {
+        cumulative+=row.remaining_ms;
+        row.deadline_ms=projected_prefill_scheduling_deadline(true,9000,row.deadline_ms,
+                                                             cumulative,150);
+    }
+    need(original[1].deadline_ms==9900 && adjusted[0].deadline_ms==9900 &&
+         adjusted[1].deadline_ms==19900, "only projected-missed successor changes");
+    need(adjusted[0].remaining_ms==500 && adjusted[1].remaining_ms==1500,
+         "all FCFS work preserved");
+    need(fcfs_prefill_boundary(original).latest_start_ms==7900 &&
+         fcfs_prefill_boundary(adjusted).latest_start_ms==9400, "independent FCFS arithmetic");
+    const BatchCostBin bin{80,3,1};
+    const std::array<CompletionBudgetView,1> decodes{{{0,100,412,33}}};
+    need(choose_fcfs_completion_unit(9000,original,200,bin,40,decodes)==CompletionChoice::Prefill,
+         "original hard PF");
+    need(choose_fcfs_completion_unit(9000,adjusted,200,bin,40,decodes)==CompletionChoice::Decode,
+         "projected queue allows decode");
+    need(choose_fcfs_completion_unit(9000,adjusted,200,bin,40,decodes,false)==CompletionChoice::Decode,
+         "no admission slot cannot license PF");
+    validate_projected_prefill_grace(false,false,false);
+    validate_projected_prefill_grace(true,true,true);
+    rejects([] { validate_projected_prefill_grace(true,false,true); });
+    rejects([] { validate_projected_prefill_grace(true,true,false); });
+}
+int main(int argc, char** argv) {
+    try {
+        if (argc==1) { cases(); }
+        else if (std::string_view(argv[1])=="invalid") {
+            rejects([] { (void)projected_prefill_grace_enabled(); });
+        } else {
+            need(projected_prefill_grace_enabled()==(std::string_view(argv[1])=="1"),
+                 "environment parser");
+        }
+        return 0;
+    } catch (const std::exception& e) {
+        std::cerr << e.what() << '\n';
+        return 1;
+    }
+}
