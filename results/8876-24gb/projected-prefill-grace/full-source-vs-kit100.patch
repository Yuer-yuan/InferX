+
+int main(int argc, char** argv) {
+    using Slots = ninfer::targets::qwen3_6::detail::cold_memory_test::LinearStateSlots;
+    const std::string_view mode = argc > 1 ? argv[1] : "default";
+    try {
+        if (mode == "invalid-cold") {
+            try { (void)ninfer::runtime::cold_request_state_enabled(); }
