+    int failures=0;
+    const std::array<int,7> oracle_rows{0,1,127,1023,2559,4095,5119};
+    std::vector<int> tokens{2,4,8,13};
+    if(k==17408) tokens.push_back(16);
+    for(int t:tokens){
+        Tensor input(dx.data(),DType::BF16,{k,t}), output(out.data(),DType::BF16,{n,t});
+        auto execute=[&]{
+            tst::cuda_check(cudaMemcpyAsync(out.data(),source.data(),out.bytes(),cudaMemcpyDeviceToDevice,stream),"restore residual");
+            workspace.reset();
+            ops::linear_add(input,weight,output,workspace,stream);
+        };
+        execute();tst::cuda_synchronize(stream);
+        auto reference_bits=tst::from_device<std::uint16_t>(out.data(),size_t(n)*t);
+        std::vector<double> actual,oracle;
+        for(int col=0;col<t;++col) for(int row:oracle_rows){
+            double sum=double(residual[size_t(col)*n+row]);
+            for(int j=0;j<k;++j)
+                sum+=tst::quantized_weight::logical_weight_fp64(packed,row,j)*double(activation[size_t(col)*k+j]);
+            oracle.push_back(sum);actual.push_back(tst::bf16_to_f32(reference_bits[size_t(col)*n+row]));
+        }
+        const std::string label="Q5 ordered residual K="+std::to_string(k)+" T="+std::to_string(t);
+        failures+=tst::verify_reduction(label,actual,oracle,{1./256,1./256,2./256});
+        for(auto value:reference_bits) if((value&0x7f80U)==0x7f80U){++failures;break;}
+        cudaGraph_t graph{};cudaGraphExec_t executable{};
+        tst::cuda_check(cudaStreamBeginCapture(stream,cudaStreamCaptureModeThreadLocal),"capture begin");execute();
+        tst::cuda_check(cudaStreamEndCapture(stream,&graph),"capture end");
+        tst::cuda_check(cudaGraphInstantiate(&executable,graph,0),"instantiate");
+        size_t changed=0;
+        for(int repeat=0;repeat<64;++repeat){
+            if(repeat&1)tst::cuda_check(cudaGraphLaunch(executable,stream),"graph repeat");else execute();
+            tst::cuda_synchronize(stream);
+            auto bits=tst::from_device<std::uint16_t>(out.data(),size_t(n)*t);
+            for(size_t i=0;i<bits.size();++i)changed+=bits[i]!=reference_bits[i];
+        }
+        std::cout<<label<<" repeats=64 changed_elements="<<changed<<'\n';
+        if(changed)++failures;
+        tst::cuda_check(cudaGraphExecDestroy(executable),"destroy exec");
+        tst::cuda_check(cudaGraphDestroy(graph),"destroy graph");
+        auto all_output=tst::from_device<std::uint16_t>(out.data(),initial.size());
+        for(size_t i=size_t(n)*t;i<initial.size();++i)if(all_output[i]!=initial[i]){++failures;break;}
+    }
+    failures+=dx.verify_guards("ordered activation")+dw.verify_guards("ordered weights")+source.verify_guards("reset source")+out.verify_guards("ordered output");
+    failures+=tst::from_device<std::uint16_t>(dx.data(),x.size())!=x;
+    failures+=tst::from_device<std::uint16_t>(source.data(),initial.size())!=initial;
+    failures+=tst::from_device<std::uint8_t>(dw.data(),packed.payload.size())!=packed.payload;
+    tst::cuda_check(cudaStreamDestroy(stream),"destroy stream");
+    return failures;
+}
+}
+int main(){
+    if(tst::cuda_unavailable())return 77;
+    try{return run(6144)+run(17408)==0?0:1;}
+    catch(const std::exception&e){std::cerr<<e.what()<<'\n';return 1;}
+}
