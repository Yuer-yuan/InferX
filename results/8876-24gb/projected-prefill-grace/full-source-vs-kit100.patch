+#pragma once
+#include <cstdint>
+#include <cstdlib>
+#include <stdexcept>
+#include <string_view>
+namespace ninfer::ops::detail {
+inline bool parse_q4_draft_head_t16(const char* value) {
+    if (!value || std::string_view(value) == "0") return false;
+    if (std::string_view(value) == "1") return true;
+    throw std::invalid_argument("NINFER_Q4_DRAFT_HEAD_T16 must be 0 or 1");
+}
+inline bool q4_draft_head_t16_enabled() {
+    static const bool enabled = parse_q4_draft_head_t16(std::getenv("NINFER_Q4_DRAFT_HEAD_T16"));
+    return enabled;
+}
+inline constexpr bool q4_draft_head_t16_shape(std::int32_t n, std::int32_t k,
+                                             std::int32_t t, bool enabled) noexcept {
+    return enabled && n == 131072 && k == 5120 && t >= 9 && t <= 16;
+}
+} // namespace ninfer::ops::detail
