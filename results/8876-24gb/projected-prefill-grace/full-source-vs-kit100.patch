+// Keep the original proposal only when the two most recent matching N5
+// histories agree. A third older match never resolves disagreement of the first two.
+inline PromptLookupDraft find_prompt_lookup_n5_consensus_draft(
+    std::span<const TokenId> ledger, std::uint32_t max_drafts = 3) noexcept {
+    PromptLookupDraft first{};
+    const std::size_t total = ledger.size();
+    const std::size_t limit = std::min<std::size_t>(max_drafts, first.tokens.size());
+    if (total < 10 || limit == 0) { return first; }
+    for (std::size_t i = total - 5; i >= 5; --i) {
+        const std::size_t pos = i - 1;
+        bool matches = true;
+        for (std::size_t n = 0; n < 5; ++n) {
+            matches = matches && ledger[pos - 4 + n] == ledger[total - 5 + n];
+        }
+        if (!matches) { continue; }
+        const auto count = static_cast<std::uint32_t>(std::min(limit, total - pos - 1));
+        if (first.count == 0) {
+            first.count = count;
+            std::copy_n(ledger.begin() + pos + 1, count, first.tokens.begin());
+            continue;
+        }
+        if (first.count != count) { return {}; }
+        for (std::uint32_t d = 0; d < count; ++d) {
+            if (first.tokens[d] != ledger[pos + 1 + d]) { return {}; }
+        }
+        return first;
+    }
+    return {};
+}
