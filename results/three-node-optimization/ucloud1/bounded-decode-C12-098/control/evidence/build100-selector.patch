+++ b/src/runtime/engine/slo_bounded_decode_membership.h
@@ -0,0 +1,96 @@
+#pragma once
+
+#include "runtime/engine/slo_completion_policy.h"
+
+namespace ninfer::runtime {
+inline bool parse_bounded_decode_membership(const char* value) {
+    if (value == nullptr || std::string_view(value) == "0") { return false; }
+    if (std::string_view(value) == "1") { return true; }
+    throw std::invalid_argument("NINFER_SCHED_BOUNDED_DECODE_MEMBERSHIP supports 0/1");
+}
+
+inline bool bounded_decode_membership_enabled() {
+    static const bool enabled = parse_bounded_decode_membership(
+        std::getenv("NINFER_SCHED_BOUNDED_DECODE_MEMBERSHIP"));
+    return enabled;
+}
+
+struct BoundedDecodeView {
+    std::uint32_t lane = 0;
+    CompletionBudgetView completion;
+    bool live = true;
+};
+
+// Advance only after an actual decode round has completed. PF, a speculative
+// selection, and a failed/abandoned round must never consume this counter.
+class BoundedDecodeCadence {
+public:
+    [[nodiscard]] unsigned full_rounds_due() const { return full_rounds_due_; }
+    void record_completed_decode(bool was_subset) {
+        if (was_subset) { full_rounds_due_ = 2; }
+        else if (full_rounds_due_) { --full_rounds_due_; }
+    }
+private:
+    unsigned full_rounds_due_ = 0;
+};
+
+struct BoundedDecodeSelection {
+    bool use_subset = false;
+    // Indices into THIS full-ready snapshot, in the snapshot's original order.
+    // Never retain these across membership/cancellation/admission changes.
+    std::array<std::size_t, 9> indices{};
+};
+
+// Call only after the original full-membership policy has selected decode.
+// The caller must keep that PF decision and its full-B statistics unchanged.
+[[nodiscard]] inline BoundedDecodeSelection choose_bounded_decode_membership(
+    bool enabled, double now_ms, BatchCostBin full_bin,
+    std::span<const BoundedDecodeView> ready, const BoundedDecodeCadence& cadence) {
+    BoundedDecodeSelection result;
+    if (!enabled || cadence.full_rounds_due() || ready.size() < 10 || ready.size() > 14) {
+        return result;
+    }
+    if (!full_bin.observations || !std::isfinite(now_ms) || now_ms < 0 ||
+        !std::isfinite(full_bin.round_ms) || full_bin.round_ms <= 0 ||
+        !std::isfinite(full_bin.tokens_per_row_round) || full_bin.tokens_per_row_round <= 0) {
+        return result;
+    }
+    const double omitted_guard_ms = 3.0 * full_bin.round_ms;
+    if (!std::isfinite(omitted_guard_ms)) { return result; }
+
+    struct Ranked { std::size_t index; std::uint32_t lane; double laxity_ms; };
+    std::array<Ranked, 14> ranked{};
+    for (std::size_t i = 0; i < ready.size(); ++i) {
+        const auto& row = ready[i];
+        const auto& request = row.completion;
+        if (!row.live || !request.committed_tokens || !request.remaining_tokens ||
+            !std::isfinite(request.first_token_ms) || request.first_token_ms < 0 ||
+            request.first_token_ms > now_ms ||
+            request.remaining_tokens > std::numeric_limits<unsigned>::max() - request.committed_tokens) {
+            return result;
+        }
+        for (std::size_t j = 0; j < i; ++j) {
+            if (ready[j].lane == row.lane) { return result; }
+        }
+        // Exactly the existing completion policy's public-40ms arithmetic.
+        const unsigned total = request.committed_tokens + request.remaining_tokens;
+        const double deadline_ms = request.first_token_ms + (total - 1) * 40.0;
+        const double rounds = completion_remaining_rounds(request, full_bin.tokens_per_row_round);
+        const double laxity_ms = deadline_ms - now_ms - rounds * full_bin.round_ms;
+        if (!std::isfinite(laxity_ms)) { return result; }
+        ranked[i] = {i, row.lane, laxity_ms};
+    }
+    std::sort(ranked.begin(), ranked.begin() + ready.size(), [](const Ranked& a, const Ranked& b) {
+        if (a.laxity_ms != b.laxity_ms) { return a.laxity_ms < b.laxity_ms; }
+        return a.lane < b.lane;
+    });
+    if (!(ranked[0].laxity_ms < 0.0)) { return result; }
+    for (std::size_t i = result.indices.size(); i < ready.size(); ++i) {
+        if (ranked[i].laxity_ms < omitted_guard_ms) { return result; }
+    }
+    for (std::size_t i = 0; i < result.indices.size(); ++i) { result.indices[i] = ranked[i].index; }
+    std::sort(result.indices.begin(), result.indices.end());
+    result.use_subset = true;
+    return result;
+}
+} // namespace ninfer::runtime
