--- /dev/null
+++ b/tests/test_slo_bounded_decode_membership.cpp
@@ -0,0 +1,143 @@
+#include "runtime/engine/slo_bounded_decode_membership.h"
+
+#include <cassert>
+#include <iostream>
+#include <vector>
+
+namespace {
+using namespace ninfer::runtime;
+constexpr double now = 10000;
+constexpr double infinity = std::numeric_limits<double>::infinity();
+constexpr double nan = std::numeric_limits<double>::quiet_NaN();
+constexpr BatchCostBin cost{100, 2, 1};
+
+BoundedDecodeView row(std::uint32_t lane, double laxity) {
+    // 100 total tokens, 20 remaining: 10 batch rounds; original deadline = first + 99*40.
+    return {lane, {7040 + laxity, 80, 20, 0}, true};
+}
+
+std::vector<BoundedDecodeView> eligible(unsigned count = 14) {
+    std::vector<BoundedDecodeView> rows;
+    for (unsigned i = 0; i < count; ++i) { rows.push_back(row(i, i < 9 ? -100.0 + i : 300.0)); }
+    return rows;
+}
+
+void set_flag(const char* value) {
+#ifdef _WIN32
+    assert(_putenv_s("NINFER_SCHED_BOUNDED_DECODE_MEMBERSHIP", value ? value : "") == 0);
+#else
+    if (value) { assert(setenv("NINFER_SCHED_BOUNDED_DECODE_MEMBERSHIP", value, 1) == 0); }
+    else { assert(unsetenv("NINFER_SCHED_BOUNDED_DECODE_MEMBERSHIP") == 0); }
+#endif
+}
+
+void contracts() {
+    BoundedDecodeCadence cadence;
+    auto rows = eligible();
+    auto select = [&](const auto& input, BatchCostBin bin = cost, double at = now) {
+        return choose_bounded_decode_membership(true, at, bin, input, cadence);
+    };
+    assert(!choose_bounded_decode_membership(false, now, cost, rows, cadence).use_subset);
+    assert(!choose_bounded_decode_membership(false, nan, {}, {}, cadence).use_subset);
+    for (unsigned count : {0U, 1U, 9U, 15U, 32U}) { assert(!select(eligible(count)).use_subset); }
+    for (unsigned count = 10; count <= 14; ++count) {
+        const auto chosen = select(eligible(count));
+        assert(chosen.use_subset);
+        for (std::size_t i = 0; i < 9; ++i) { assert(chosen.indices[i] == i); }
+    }
+    assert(!select(rows, {100, 2, 0}).use_subset);
+    for (double bad : {0.0, -1.0, infinity, -infinity, nan}) {
+        assert(!select(rows, {bad, 2, 1}).use_subset);
+        assert(!select(rows, {100, bad, 1}).use_subset);
+    }
+    for (double bad : {-1.0, infinity, -infinity, nan}) { assert(!select(rows, cost, bad).use_subset); }
+    assert(!select(rows, {std::numeric_limits<double>::max(), 2, 1}).use_subset);
+    rows = eligible();
+    for (auto& r : rows) { r = row(r.lane, 0); }
+    assert(!select(rows).use_subset); // No strictly negative laxity.
+    rows = eligible(); rows[9] = row(9, 299.999);
+    assert(!select(rows).use_subset); // Every omitted request must pass the guard.
+    rows[9] = row(9, 300);
+    assert(select(rows).use_subset); // Exact three-full-round boundary is allowed.
+
+    // Nine-way tie selection uses lane, then restores the original snapshot order.
+    rows.clear(); rows.push_back(row(99, -1));
+    for (unsigned lane = 9; lane; --lane) { rows.push_back(row(lane - 1, 500)); }
+    auto chosen = select(rows); assert(chosen.use_subset);
+    assert(chosen.indices[0] == 0);
+    for (std::size_t i = 1; i < 9; ++i) { assert(chosen.indices[i] == i + 1); }
+
+    rows = eligible();
+    for (std::size_t i = 0; i < rows.size(); ++i) {
+        auto invalid = rows; invalid[i].live = false; assert(!select(invalid).use_subset);
+        invalid = rows; invalid[i].completion.remaining_tokens = 0; assert(!select(invalid).use_subset);
+        invalid = rows; invalid[i].completion.committed_tokens = 0; assert(!select(invalid).use_subset);
+        invalid = rows; invalid[i].completion.remaining_tokens = std::numeric_limits<unsigned>::max();
+        assert(!select(invalid).use_subset);
+        for (double bad : {-1.0, now + 1, infinity, -infinity, nan}) {
+            invalid = rows; invalid[i].completion.first_token_ms = bad; assert(!select(invalid).use_subset);
+        }
+    }
+    rows[13].lane = rows[0].lane; assert(!select(rows).use_subset);
+
+    // Own-yield max, not the batch average alone, can establish urgency.
+    rows = eligible();
+    for (auto& r : rows) { r = row(r.lane, 500); }
+    assert(!select(rows).use_subset);
+    rows[13].completion.committed_decode_rounds = 158; // Own yield = 79/158; clamps to one.
+    chosen = select(rows); assert(chosen.use_subset && chosen.indices[8] == 13);
+    // Valid non-512 output budgets use the same original completion equation.
+    rows = eligible(); rows[0].completion = {8000, 50, 10, 0};
+    assert(select(rows).use_subset);
+
+    rows = eligible(); chosen = select(rows); assert(chosen.use_subset);
+    cadence.record_completed_decode(true); assert(cadence.full_rounds_due() == 2);
+    assert(!select(rows).use_subset); // Selection itself does not consume a round.
+    assert(cadence.full_rounds_due() == 2);
+    // An intervening PF calls no record_completed_decode; two full rounds remain due.
+    assert(!select(rows).use_subset && cadence.full_rounds_due() == 2);
+    cadence.record_completed_decode(false); assert(cadence.full_rounds_due() == 1);
+    rows.pop_back(); rows[0] = row(77, -50); // Completion/cancellation and lane reuse.
+    assert(!select(rows).use_subset);
+    cadence.record_completed_decode(false); assert(cadence.full_rounds_due() == 0);
+    assert(select(rows).use_subset);
+    cadence.record_completed_decode(false); assert(cadence.full_rounds_due() == 0);
+
+    // Integration contract: update only indices from the actual selected snapshot.
+    rows = eligible(); chosen = select(rows); assert(chosen.use_subset);
+    std::array<unsigned, 14> served{};
+    for (auto i : chosen.indices) { ++served[i]; }
+    for (std::size_t i = 0; i < served.size(); ++i) { assert(served[i] == (i < 9 ? 1U : 0U)); }
+    CompletionCostModel<32> observations;
+    observations.observe(chosen.indices.size(), 80, chosen.indices.size() * 3);
+    assert(observations.get(9).observations == 1);
+    assert(observations.get(14).observations == 0);
+}
+} // namespace
+
+int main(int argc, char** argv) {
+    assert(!parse_bounded_decode_membership(nullptr));
+    assert(!parse_bounded_decode_membership("0"));
+    assert(parse_bounded_decode_membership("1"));
+    for (const char* bad : {"", "2", "-1", "on", "true", " 1", "1 ", "nan"}) {
+        bool rejected = false;
+        try { (void)parse_bounded_decode_membership(bad); }
+        catch (const std::invalid_argument&) { rejected = true; }
+        assert(rejected);
+    }
+    assert(argc == 1 || argc == 2);
+    if (argc == 2 && std::string_view(argv[1]) == "invalid") {
+        set_flag("2"); bool rejected = false;
+        try { (void)bounded_decode_membership_enabled(); }
+        catch (const std::invalid_argument&) { rejected = true; }
+        assert(rejected); set_flag(nullptr); assert(!bounded_decode_membership_enabled());
+    } else {
+        set_flag(argc == 1 ? nullptr : argv[1]);
+        const bool expected = argc == 2 && std::string_view(argv[1]) == "1";
+        assert(bounded_decode_membership_enabled() == expected);
+        set_flag(expected ? "0" : "1");
+        assert(bounded_decode_membership_enabled() == expected);
+    }
+    contracts();
+    std::cout << "bounded membership selector/cadence CPU contracts passed; no performance claim\n";
+}
