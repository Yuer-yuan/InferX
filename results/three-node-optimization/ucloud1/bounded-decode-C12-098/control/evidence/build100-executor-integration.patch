+    // Invoked ONLY after the original worker selected decode using full-ready membership.
+    void run_bounded_decode_round(const RoundMembership& full) {
+        if (!bounded_decode_membership_scheduler_) {
+            run_decode_round(full);
+            return;
+        }
+        std::array<BoundedDecodeView, kMaximumConcurrency> views{};
+        for (std::size_t i = 0; i < full.size; ++i) {
+            const auto lane = full.lanes[i];
+            const auto& request = slots_[lane];
+            auto& view = views[i];
+            view.lane = lane;
+            view.live = request != nullptr && request->decode_ready && request->first_token &&
+                        request->budget &&
+                        !request->cancelled.load(std::memory_order_acquire) &&
+                        request->generated.size() <= std::numeric_limits<unsigned>::max();
+            if (!view.live) { continue; }
+            view.completion = {
+                std::chrono::duration<double, std::milli>(
+                    request->first_token->time_since_epoch()).count(),
+                static_cast<unsigned>(request->generated.size()), request->budget->remaining(),
+                request_yield_max_scheduler_ ? request->committed_decode_rounds : 0};
+        }
+        const auto selection = choose_bounded_decode_membership(
+            true, SchedulerTrace::now_ms(), completion_costs_.get(static_cast<unsigned>(full.size)),
+            std::span<const BoundedDecodeView>(views.data(), full.size), bounded_decode_cadence_);
+        RoundMembership selected;
+        if (selection.use_subset) {
+            for (const auto index : selection.indices) {
+                selected.lanes[selected.size] = full.lanes[index];
+                selected.budgets[selected.size] = full.budgets[index];
+                ++selected.size;
+            }
+        }
+        // Original resolve/cancel/output/stats operate on exactly these actual lanes.
+        run_decode_round(selection.use_subset ? selected : full);
+        bounded_decode_cadence_.record_completed_decode(selection.use_subset);
+        if (selection.use_subset && !bounded_decode_first_subset_logged_) {
+            bounded_decode_first_subset_logged_ = true;
+            std::fprintf(stderr,
+                         "bounded_decode_membership_first_success full_B=%zu selected_B=%zu full_rounds_due=%u\n",
+                         full.size, selected.size, bounded_decode_cadence_.full_rounds_due());
+        }
+    }
