% 2. 问题与目标
\begin{frame}{02\quad 问题与目标}
\ixsubline{瓶颈不是只有 Decode：冷 Prefill 会同时拉长首 token 和已开始请求的等待。}
\begin{columns}[T,onlytextwidth]
\begin{column}{.60\textwidth}
\begin{tikzpicture}[x=.72cm,y=.85cm]
\foreach \y/\label in {0/请求1,-1/请求2,-2/请求3}{
  \node[anchor=east,font=\scriptsize,color=Muted] at (.0,\y+.2) {\label};}
\fill[Orange!75] (.15,0) rectangle (2.5,.45);
\fill[Teal!75] (2.5,0) rectangle (3,.45);
\fill[Line] (3,0) rectangle (5.5,.45);
\fill[Teal!75] (5.5,0) rectangle (6,.45);
\fill[Line] (.15,-1) rectangle (3,-.55);
\fill[Orange!75] (3,-1) rectangle (5.5,-.55);
\fill[Teal!75] (5.5,-1) rectangle (6,-.55);
\fill[Line] (.15,-2) rectangle (6,-1.55);
\node[font=\scriptsize] at (1.3,.22) {Prefill};
\node[font=\scriptsize] at (4.2,-.78) {Prefill};
\node[font=\scriptsize,color=Muted] at (3.1,-1.78) {等待准入 / 计算机会};
\draw[flow] (.15,.8)--(6.8,.8) node[right,font=\scriptsize]{时间};
\node[font=\tiny,color=Teal,align=center] at (6.4,-.65) {Decode\\分批执行};
\end{tikzpicture}
\ixnote{串行竞争示意，非实测时间比例。原生计时与 Nsight 支持瓶颈诊断；不作带宽饱和声明。}
\vspace{3mm}
\begin{block}{评测看每条请求的实际体验}
\small $\mathrm{TPOT}_i=\dfrac{\mathrm{E2E}_i-\mathrm{TTFT}_i}{512-1}$\quad 再对请求取 P95。
\end{block}
\end{column}
\begin{column}{.36\textwidth}
\ixmetric{10s}{TTFT P95 上限}{客户端计时，包含排队及网络}
\vspace{2mm}
\ixmetric{40ms}{TPOT P95 上限}{全请求平均，非单个流式包间隔}
\vspace{2mm}
\small 固定单卡、8192输入 / 512输出。\par\vspace{2mm}
\ixnote{ZIP默认 C1/2/4/8、各100+8；本轮扩展 C8/12/16/32、各128+8。质量另用原前100、C2、32768输出预算。}
\end{column}
\end{columns}
\end{frame}

% 3. 整体方案
\begin{frame}{03\quad 整体方案}
\ixsubline{保留 Qwen 模型与 NInfer/MTP 基础，围绕真实热点扩展低比特覆盖。}
\begin{columns}[T,onlytextwidth]
\begin{column}{.57\textwidth}
\begin{tikzpicture}[node distance=4mm]
\node[box,text width=6.8cm] (src) {固定 FP8 来源 + 独立校准激活};
\node[box,text width=6.8cm,below=of src] (cal) {H512 旋转 / G512 / GPTQ\quad 生成有哈希的缓存};
\node[box,text width=2.8cm,below left=5mm and 0mm of cal.south] (pf) {冷 Prefill\\低比特 dense 投影};
\node[box,text width=2.8cm,below right=5mm and 0mm of cal.south] (dec) {Decode / Verify\\MTP K3 + 原生批处理};
\node[box,text width=6.8cm,below=20mm of cal] (state) {独立 KV / GDN 状态\\保留原语义、回滚及数值检查};
\node[box,text width=6.8cm,below=of state] (api) {OpenAI API \(\rightarrow\) 原版评测 \(\rightarrow\) 原始逐请求证据};
\draw[flow] (src)--(cal);
\draw[flow] (cal.south)-|(pf.north);
\draw[flow] (cal.south)-|(dec.north);
\draw[flow] (pf.south)|-(state.west);
\draw[flow] (dec.south)|-(state.east);
\draw[flow] (state)--(api);
\end{tikzpicture}
\end{column}
\begin{column}{.39\textwidth}
\begin{block}{选择 NInfer 的依据}
\small 紧凑权重、原生 MTP、可追踪 CUDA 路由；可直接改进热点并保留原版客户端统计。
\end{block}
\begin{block}{扩展覆盖，而非只换标签}
\small 64层 FFN gate/up + down；\par attention/GDN 输入投影；\par 47层 GDN 输出 Prefill 路径。
\end{block}
\ixnote{vLLM / SGLang FP8 用作框架参照。量化格式、采样和配置不同的结果分别报告。Norm、递推状态等不宣称“全4bit”。}
\end{column}
\end{columns}
\vspace{1mm}\ixnote{来源：025全层GPTQ；041输入缓存；047输出缓存；最新 output47 路径仍需同版完整任务质量。}
\end{frame}

% 4. 核心实现
\begin{frame}{04\quad 核心实现}
\ixsubline{先用时间线定位，再按矩阵覆盖、状态正确性和端到端结果逐级推进。}
\begin{columns}[T,onlytextwidth]
\begin{column}{.50\textwidth}
\begin{tikzpicture}[node distance=3mm]
\node[box,text width=6.7cm] (a) {量化：旋转 + GPTQ \(\rightarrow\) 真 S4 MMA\\128个 FFN 矩阵，保留 scale / SiLU / 残差语义};
\node[box,text width=6.7cm,below=of a] (b) {执行：共享输入投影 + 原生 B16/B32\\Graph、工作区、KV / GDN 回滚共同验证};
\node[box,text width=6.7cm,below=of b] (c) {调度：分块 Prefill + 完成预算\\同时控制首 token 和生成过程中等待};
\draw[flow] (a)--(b);\draw[flow] (b)--(c);
\end{tikzpicture}
\vspace{2mm}
\ixnote{我们：量化缓存、算子接入、批扩容、调度与证据工具。\par 上游：模型、NInfer引擎、基础量化格式及MTP机制。}
\end{column}
\begin{column}{.46\textwidth}
\begin{tikzpicture}
\begin{axis}[width=6.6cm,height=3.6cm,ybar,bar width=15pt,ymin=0,ymax=430,
 xtick={1,2,3},xticklabels={FFN S4,加输入,加输出},ylabel={输出 tok/s},
 nodes near coords,nodes near coords style={font=\scriptsize},
 title={C32 同节点累计版本进展}]
\addplot[fill=Teal!80,draw=none] coordinates {(1,305.910173) (2,352.410492) (3,363.576857)};
\end{axis}
\end{tikzpicture}\par
\ixnote{同为128+8、K3、冷8192/512；量化覆盖随版本变化。\par 累计吞吐增加 18.9\%，仍未通过C32延迟；非单算子因果增益。}
\vspace{2mm}
{\color{Teal}\large\bfseries 347 条实验/检查记录}\par
\ixnote{三节点ledger逐文件去完全重复行；含CPU、算子、整模、审计，不能等同独立GPU成功次数。}
\end{column}
\end{columns}
\end{frame}

