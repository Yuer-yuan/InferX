% 6. 工程化设计
\begin{frame}{06\quad 工程化设计}
\ixsubline{每个成绩都能追到输入、原始输出、配置和实际运行版本。}
\begin{tikzpicture}[node distance=3mm]
\node[box,text width=2.3cm] (a) {源码 / binary\\模型 / 缓存 SHA};
\node[box,text width=2.3cm,right=of a] (b) {数值 / 状态门\\Graph / 路由检查};
\node[box,text width=2.3cm,right=of b] (c) {原版客户端\\逐请求 / GPU日志};
\node[box,text width=2.3cm,right=of c] (d) {独立重算\\原始失败保留};
\node[box,text width=2.3cm,right=of d] (e) {材料快照\Markdown / TeX};
\draw[flow] (a)--(b);\draw[flow] (b)--(c);\draw[flow] (c)--(d);\draw[flow] (d)--(e);
\end{tikzpicture}\par\vspace{4mm}
\begin{columns}[T,onlytextwidth]
\begin{column}{.47\textwidth}
\begin{block}{已形成的工程闭环}
\small
\begin{itemize}
\item 固定tokenizer，核验8192/512和冷缓存。
\item 原始百分位复算，保留预热与失败口径。
\item 进程身份匹配，退出与资源释放留证。
\item 新结果先审阅、注册，再生成图表与材料。
\end{itemize}
\end{block}
\end{column}
\begin{column}{.49\textwidth}
\begin{block}{可重复执行的材料 Skill}
\small
候选发现 \(\rightarrow\) 完整性/版本审核 \(\rightarrow\) 更新来源注册表\par
\(\rightarrow\) 重算指标 \(\rightarrow\) 同步图表、表格、TeX \(\rightarrow\) 哈希检查。
\end{block}
\ixnote{交付：basic/ 与 track-a/，单文件Overleaf TeX。\par 最终仍须补齐私有源码/缓存发布、干净重建及演练；当前manifest仅证明材料来源快照。}
\end{column}
\end{columns}
\end{frame}

% 7. 成本、性能与取舍
\begin{frame}{07\quad 成本、性能与取舍}
\ixsubline{算子更快不保证请求更快；收益必须经过模型、状态和质量验证。}
\begin{columns}[T,onlytextwidth]
\begin{column}{.48\textwidth}
\begin{tikzpicture}
\begin{axis}[width=6.7cm,height=4.2cm,ybar,bar width=16pt,ymin=0,ymax=65,
 symbolic x coords={parent,down053},xtick=data,
 xticklabels={原9270,加down053},ylabel={C16 TPOT P95 / ms},
 title={同机同payload：吞吐略升，尾延迟变差},nodes near coords,
 nodes near coords style={font=\scriptsize}]
\addplot[fill=Blue!75,draw=none] coordinates {(parent,51.702542) (down053,54.112965)};
\draw[dashed,Orange] (axis cs:parent,40)--(axis cs:down053,40);
\end{axis}
\end{tikzpicture}
\ixnote{单次128+8顺序对照：吞吐307.15\(\rightarrow\)311.48 (+1.41\%)，\par TPOT恶化4.66\%，不晋级；新版本也未复测C12。}
\end{column}
\begin{column}{.48\textwidth}
\begin{block}{保留失败，控制风险}
\small
\begin{tabular}{p{1.65cm}p{4.5cm}}
W2探索 & 小T gate有硬件潜力；大Prefill负收益，留出重建误差更大。\\[2mm]
FP16状态 & B32算子接近2倍；长递推精度门失败，不推广。\\[2mm]
更大batch & 能分配显存不等于TTFT/TPOT达标；C32仍有明显差距。
\end{tabular}
\end{block}
\small 单卡450W；保留量化、KV、Graph等真实预算。\par\vspace{2mm}
\ixnote{没有电价、租用时长和完整能耗积分，不填写虚构成本或能效提升。质量/稳定性证据缺口公开保留。}
\end{column}
\end{columns}
\end{frame}

% 8. 总结与不足
\begin{frame}{08\quad 总结与不足}
\begin{columns}[T,onlytextwidth]
\begin{column}{.53\textwidth}
{\color{Teal}\fontsize{22}{29}\selectfont\bfseries
从单卡部署，推进到\par 可追溯的优化闭环。}\par\vspace{4mm}
\begin{itemize}
\item 64层量化与原生高批执行接入。
\item C12 本轮SLO通过：284.75 tok/s。
\item 质量独立记录：40b3前100 strict 86\%。
\item 新结果可持续更新到同一套材料。
\end{itemize}
\vspace{3mm}
\ixnote{以上性能与质量来自不同版本，不声称联合验收完成。}
\end{column}
\begin{column}{.43\textwidth}
\begin{block}{未解决的问题}
\small C16/C32延迟未过；最新性能版缺完整质量；多seed稳定性、干净重建及最终交付冻结待完成。
\end{block}
\begin{block}{现场 Demo / 3分钟}
\small 核对单卡与版本 \(\rightarrow\) 真实流式请求 \(\rightarrow\) 输出与日志 \(\rightarrow\) 定位冻结评测原始证据。
\end{block}
