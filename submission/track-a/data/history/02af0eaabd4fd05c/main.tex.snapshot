\end{frame}

% 2. A real observation motivates the question; no cross-protocol speedup.
\begin{frame}{问题与目标}
\ixclaim{旧基线增加并发后，吞吐接近饱和，生成等待却不断增加}
\begin{columns}[T]
\begin{column}{.48\textwidth}
\centering
\small 总输出吞吐（tok/s，越高越好）\par
\begin{tikzpicture}
\begin{axis}[ixaxis,width=6.7cm,height=3.8cm,
 xmin=.6,xmax=4.5,ymin=0,ymax=130,xtick={1,2,3,4},
 xticklabels={1,2,4,8},ytick={0,40,80,120},xlabel={客户端并发}]
\addplot[Ink,thick,mark=*,nodes near coords] coordinates {(1,73.592962) (2,92.089488) (3,94.612183) (4,103.309039)};
\end{axis}
\end{tikzpicture}
\end{column}
\begin{column}{.48\textwidth}
\centering
\small 生成延迟P95（ms/token，越低越好）\par
\begin{tikzpicture}
\begin{axis}[ixaxis,width=6.7cm,height=3.8cm,
 xmin=.6,xmax=4.5,ymin=0,ymax=110,xtick={1,2,3,4},
 xticklabels={1,2,4,8},ytick={0,40,80},xlabel={客户端并发}]
\addplot[Fail,thick,mark=*,nodes near coords] coordinates {(1,9.009001) (2,22.506397) (3,45.929756) (4,90.659709)};
