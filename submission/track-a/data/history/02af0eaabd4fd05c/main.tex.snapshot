\end{column}
\end{columns}
\vspace{2mm}
\textbf{成功标准：}首字P95 $\leq$ 10s，生成P95 $\leq$ 40ms。\par
\small 首字计入排队和输入处理；生成计入首字之后的等待。质量另用IFBench检查。
\vspace{3mm}
\ixnote{旧NInfer b604d050，同机单卡、冷8192/512、100正式+8预热。P95表示95\%请求不超过该值；后续扩展评测为128+8，不计算跨协议加速比。}
\end{frame}

% 3. One architecture, with actual deployment and contribution boundaries.
\begin{frame}{整体方案}
\ixclaim{选用可改CUDA的NInfer，同时优化计算、状态与调度}
{\centering
\begin{tikzpicture}[x=1cm,y=1cm]
\node[font=\small,align=center] (api) at (.15,.7) {API\\请求};
\node[component,text width=1.25cm] (queue) at (1.9,.7) {等待\\队列};
\node[change,text width=2.1cm] (sched) at (4.65,.7) {调度器\\输入 / 生成};
\draw[Guide] (6.45,-1.8) rectangle (10.55,1.8);
\node[font=\small,anchor=west] at (6.55,1.52) {单张48GB 4090};
\node[component,text width=3.05cm,minimum height=1.1cm] (exec) at (8.5,.55)
 {分块预填充\\MTP生成验证\\INT4计算路径};
\node[state,text width=3.05cm] (st) at (8.5,-1.1) {KV与递推状态\\各自进度 / 槽位};
\node[change,text width=2.1cm] (cache) at (4.65,-1.1) {离线校准\\4bit权重};
\node[font=\small,align=center] (out) at (12.15,.7) {流式\\回答};
\draw[flow] (api)--(queue);
\draw[flow] (queue)--(sched);
\draw[flow] (sched.east)--(exec.west);
\draw[flow] (exec.east)--(out);
\draw[flow] (cache.east)--(6.1,-1.1)--(6.1,-.25)--(exec.south west);
\draw[{Latex[length=1.1mm]}-{Latex[length=1.1mm]},draw=State,semithick] (exec.south)--(st.north);
\draw[feedback] (st.south)--(8.5,-2.15)--(2.9,-2.15)--(2.9,-.15)--(sched.south west);
\node[font=\footnotesize,text=State,fill=white] at (4.35,-2.15) {按请求反馈生成进度};
\end{tikzpicture}\par}
\vspace{2mm}
\small \textbf{计算：}4bit降低大矩阵开销。\quad \textbf{MTP：}提议多个token后统一验证。\par
\small \textbf{调度：}协调长输入与生成。\quad \textbf{状态：}保证并发接受、回滚互不串扰。
\vspace{3mm}
\ixnote{部署：最大上下文65536、输入块2048、INT8 KV、MTP K3。棕色为团队改造机制，蓝色为状态；NInfer与基础MTP来自上游，团队另改批执行与状态管理。}
\end{frame}

% 4. Quantization is a complete computation path, not a file-size claim.
\begin{frame}{核心实现}
\ixclaim{量化落到计算路径：权重和激活都进入INT4矩阵指令}
{\centering
\begin{tikzpicture}[x=1cm,y=1cm]
\node[font=\small,align=right] (w) at (.5,1.2) {模型权重\\离线处理};
\node[change,text width=2.25cm] (wq) at (3.1,1.2) {GPTQ校准\\4bit权重};
\node[font=\small,align=right] (x) at (.5,-.6) {输入激活\\在线处理};
\node[change,text width=2.25cm] (xq) at (3.1,-.6) {动态量化\\4bit激活};
\node[change,text width=2.1cm,minimum height=1.2cm] (mma) at (6.8,.3) {INT4点积\\矩阵指令};
\node[component,text width=1.6cm] (scale) at (9.8,.3) {缩放累加};
\node[font=\small,align=center] (out) at (12.1,.3) {BF16\\输出};
\draw[flow] (w)--(wq);
\draw[flow] (x)--(xq);
\draw[flow] (wq.east)--(mma.north west);
\draw[flow] (xq.east)--(mma.south west);
\draw[flow] (mma)--(scale);
\draw[flow] (scale)--(out);
\draw[flow] (wq.north)--(3.1,2.2)--(9.8,2.2)--(scale.north);
\node[font=\footnotesize,fill=white] at (6.5,2.2) {权重缩放值};
\draw[flow] (xq.south)--(3.1,-1.6)--(9.8,-1.6)--(scale.south);
\node[font=\footnotesize,fill=white] at (6.5,-1.6) {激活缩放值};
\end{tikzpicture}\par}
\vspace{2mm}
\textbf{覆盖路线：}64层、128个前馈矩阵 $\rightarrow$ 输入投影 $\rightarrow$ 输出投影。\par
\small 校准降低量化误差；数值、真实模型路由和任务输出分层检查。
\vspace{3mm}
\ixnote{H512变换、G512分组；独立文本校准。其余算子和状态保留原格式，量化仍有误差；参考GPTQ/QuaRot/Atom。}
\end{frame}

% 5. Concurrency changes execution and state, rather than just an HTTP limit.
\begin{frame}{核心实现}
\ixclaim{并发扩容的关键：每个请求的状态跟随自己的提交进度}
{\centering
\begin{tikzpicture}[x=1cm,y=1cm]
\node[font=\small] at (3.8,1.8) {MTP提议3个token};
\node[font=\small] at (9.8,1.8) {验证后独立更新状态};
\node[font=\small] (a) at (.4,.75) {请求A};
\node[font=\small] (b) at (.4,-.85) {请求B};
\node[token,fill=Work!12] (aone) at (2.6,.75) {a1};
\node[token,fill=Work!12] at (3.8,.75) {a2};
\node[token,dashed,text=Guide] (athree) at (5,.75) {a3};
\node[token,fill=Work!12] (bone) at (2.6,-.85) {b1};
\node[token,dashed,text=Guide] at (3.8,-.85) {b2};
\node[token,dashed,text=Guide] (bthree) at (5,-.85) {b3};
\node[component,text width=1cm] (va) at (6.7,.75) {验证};
\node[component,text width=1cm] (vb) at (6.7,-.85) {验证};
\node[state,text width=3.55cm] (sa) at (10.1,.75) {A：接受前2个\\按实际提交更新状态};
\node[state,text width=3.55cm] (sb) at (10.1,-.85) {B：接受前1个\\按实际提交更新状态};
\draw[flow] (a)--(aone);
\draw[flow] (b)--(bone);
\draw[flow] (5.5,.75)--(va.west);
\draw[flow] (5.5,-.85)--(vb.west);
\draw[flow] (va.east)--(sa.west);
\draw[flow] (vb.east)--(sb.west);
\node[font=\footnotesize,text=Guide] at (3.8,-1.65) {实框：接受；虚框：未接受（机制示意）};
\end{tikzpicture}\par}
\vspace{3mm}
\textbf{从8扩到16/32批执行：}同步扩槽位、工作区和CUDA Graph。\par
\small 状态隔离、部分提交与回滚验证通过，才有资格进入服务压测。
\vspace{3mm}
\ixnote{接受长度仅示意，省略目标回退token。KV、递推状态与进度按实际提交独立维护；MTP来自上游，团队扩展批执行及状态管理，并核验回滚与槽位生命周期。}
\end{frame}

% 6. Scheduling mechanism and a bounded, real end-to-end observation.
\begin{frame}{核心实现}
\ixclaim{长输入分块提供切换机会，再按每个请求的进度安排生成}
{\centering
\begin{tikzpicture}[x=1cm,y=1cm]
\node[font=\small,anchor=west] at (0,1.55) {8192-token新输入};
\foreach \i in {0,1,2,3}{
 \draw[Guide,fill=Guide!6] (4.4+\i*1.6,1.1) rectangle (5.95+\i*1.6,1.85);
 \node[font=\small] at (5.175+\i*1.6,1.475) {2048};
}
\node[font=\small,anchor=west] at (0,-.05) {一张GPU的执行顺序};
\draw[flow] (4.2,-.2)--(12.6,-.2);
\foreach \i in {0,1,2,3}{
 \draw[Guide,fill=Guide!6] (4.4+\i*2,-.6) rectangle (5.5+\i*2,.2);
 \node[font=\small] at (4.95+\i*2,-.2) {输入块};
 \draw[Work,fill=Work!10] (5.55+\i*2,-.6) rectangle (6.35+\i*2,.2);
 \node[font=\small,text=Work] at (5.95+\i*2,-.2) {生成};
}
\draw[flow] (7.6,1.1)--node[right,font=\footnotesize]{块间重新选择下一段工作}(7.6,.35);
\node[change,text width=8.5cm] (budget) at (7.5,-1.65)
 {逐请求估计剩余工作\\依据：实际已提交的token};
\draw[flow] (budget.north)--(7.5,-.6);
\end{tikzpicture}\par}
\vspace{3mm}
\textbf{同机16并发：}生成P95\quad 48.78 $\rightarrow$ 45.74 ms。\par
\small 下降6.23\%，仍高于40ms；继续优化慢请求的等待。
\vspace{3mm}
\ixnote{时间块仅示意可调度顺序，长度不表示耗时。2362→837f调度对照：相同payload、128+8、冷8192/512、K3/KV139264，单轮；首字9.856→9.838s，吞吐311.77→315.73 tok/s。}
\end{frame}

