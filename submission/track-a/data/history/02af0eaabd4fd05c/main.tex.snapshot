\end{columns}
\vspace{2mm}
\textbf{生成改善10.38\%，首字恶化46.37\%；两组都未达标。}\par
\small 资源固定为单卡48GB；下一步需要减少实际执行与等待开销。
\vspace{3mm}
\ixnote{2362fc01同机、同payload、K3/KV139264、128+8，单次顺序对照；吞吐311.77→306.84 tok/s。450W是功率上限；未测完整能耗和单位token费用。活动12仍是客户端16并发。}
\end{frame}

% 12. Close the argument and move to the live demonstration.
\begin{frame}{总结与不足}
\ixclaim{已经做到12并发单轮达标，下一关是更高并发的尾延迟}
\vspace{2mm}
\begin{columns}[T]
\begin{column}{.47\textwidth}
\textbf{从问题到交付}\par
\vspace{4mm}
旧基线：并发上升，吞吐接近饱和\par
\vspace{3mm}
$\rightarrow$ INT4计算、批执行与独立状态\par
\vspace{3mm}
$\rightarrow$ 分块和逐请求进度调度\par
\vspace{3mm}
$\rightarrow$ 12并发，284.75 tok/s，单轮通过
\end{column}
\begin{column}{.46\textwidth}
