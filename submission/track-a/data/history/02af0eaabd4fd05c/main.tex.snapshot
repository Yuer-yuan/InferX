% 8. Capacity is the intersection of two latency constraints.
\begin{frame}{结果与证据}
\ixclaim{同一量化版本：12并发单轮达标，16/32并发仍超限}
\begin{columns}[c]
\begin{column}{.59\textwidth}
\centering
\begin{tikzpicture}
\begin{axis}[ixaxis,width=8.5cm,height=4.7cm,
 xmin=0,xmax=28,ymin=0,ymax=125,xtick={0,10,20},
 ytick={0,40,80,120},xlabel={首字延迟P95（s）},
 ylabel={生成延迟P95（ms/token）}]
\path[fill=Pass!7] (axis cs:0,0) rectangle (axis cs:10,40);
\addplot[Pass,dashed,thick] coordinates {(0,40)(28,40)};
\addplot[Pass,dashed,thick] coordinates {(10,0)(10,125)};
\node[font=\small,text=Pass] at (axis cs:4.4,15) {双目标区};
\addplot[only marks,Pass,mark=*,mark size=3.3pt] coordinates {(9.499646,37.340162)};
\addplot[only marks,Fail,mark=x,mark size=4pt,thick] coordinates {(9.934084,51.702542) (23.694501,101.157387)};
\node[font=\small,anchor=north west,text=Pass] at (axis cs:10.4,36) {12并发};
\node[font=\small,anchor=south west,text=Fail] at (axis cs:10.6,53) {16并发};
\node[font=\small,anchor=south east,text=Fail] at (axis cs:25,105) {32并发};
\end{axis}
\end{tikzpicture}
\end{column}
\begin{column}{.37\textwidth}
{\Large\color{Pass}\textbf{284.75 tok/s}}\par
\vspace{2mm}
\textbf{12并发的通过配置}\par
\vspace{3mm}
\small 首字P95\quad 9.50s / 10s\par
生成P95\quad 37.34ms / 40ms\par
\vspace{4mm}
16 / 32并发吞吐更高，\par
但用户等待超过目标。\par
\vspace{2mm}
\textbf{吞吐不能代替延迟达标。}
\end{column}
\end{columns}
\vspace{2mm}
\ixnote{9270f73e；各128正式+8预热、冷8192/512、零错误。12/16同机，32另一同规格节点；KV随并发调整。C16/C32吞吐307.15/363.58 tok/s。单轮结果，不代表稳定容量上限。}
\end{frame}

% 9. Show what failed, rather than only a decorative accuracy percentage.
\begin{frame}{结果与证据}
\ixclaim{完整100题：84题严格通过，失败题也计入结果}
{\centering
\begin{tikzpicture}[x=1cm,y=1cm]
\fill[Pass!12] (0,0) rectangle (10.080000,.9);
\fill[Fail!12] (10.080000,0) rectangle (12,.9);
\draw[Guide] (0,0) rectangle (12,.9);
\draw[Guide] (10.080000,0)--(10.080000,.9);
\node[font=\small,text=Pass] at (5.040000,.45) {严格通过：84题};
\node[font=\small,text=Fail] at (11.040000,.45) {失败：16题};
\end{tikzpicture}\par}
\vspace{4mm}
\begin{columns}[T]
\begin{column}{.44\textwidth}
\textbf{测的是指令是否全部遵循}\par
\vspace{2mm}
\small 每题所有约束通过，才算该题通过。\par
宽松评分87/100；指令级95/111。\par
\vspace{2mm}
错误 / 空回答 / 截断：\textbf{0 / 0 / 0}
\end{column}
\begin{column}{.50\textwidth}
\textbf{真实失败例：标点覆盖约束}\par
\vspace{2mm}
\small 样本key37要求覆盖全部标准标点。\par
回答自然结束，原评分器仍判失败。\par
\vspace{2mm}
说明：正常生成不等于约束全部满足。
\end{column}
\end{columns}
\vspace{4mm}
\textcolor{Work}{\textbf{这是验证扩展版的质量；与上一页性能分别报告。}}
\vspace{3mm}
\ixnote{66328f67；C16/活动16、K3、KV532480，原前100、默认thinking/采样、max32768，原评分器复核。性能页为9270；同配置性能与质量联合验证尚未完成。}
\end{frame}

% 10. An actual log excerpt is evidence, explicitly not a simulated terminal.
\begin{frame}{工程化设计}
\ixclaim{从版本到逐请求日志，再到独立复算，让每个成绩有出处}
\begin{columns}[T]
\begin{column}{.49\textwidth}
\textbf{真实运行记录节选}\par
\vspace{3mm}
\begin{tabular}{lr}
\toprule
\small 原生JSONL字段 & \small 实际值\\
\midrule
\footnotesize\texttt{computed\_prefill\_tokens} & 8192\\
\footnotesize\texttt{prefix\_cache\_hit\_tokens} & 0\\
\footnotesize\texttt{completion\_tokens} & 512\\
\footnotesize\texttt{prefix\_reuse\_path} & \footnotesize\texttt{full\_reset}\\
\bottomrule
\end{tabular}\par
\vspace{3mm}
\small 实际冷输入、固定输出长度；\par
客户端记录另用于重算P95。
\end{column}
\begin{column}{.46\textwidth}
\textbf{可核验的交付链}\par
\vspace{3mm}
固定源码、模型、缓存、启动配置\par
\vspace{2mm}
$\rightarrow$ 接口检查与原版评测\par
\vspace{2mm}
$\rightarrow$ 逐请求计时、异常、GPU记录\par
\vspace{2mm}
$\rightarrow$ 复算延迟，对照原始汇总\par
\vspace{3mm}
\small OOM、超时、空输出与截断均保留；\par
更改配置后重新标记测试范围。
\end{column}
\end{columns}
\vspace{3mm}
\small \href{https://github.com/Yuer-yuan/InferX}{仓库 README}\quad
提供部署、原始记录与复验步骤；现场用真实请求展示服务与日志。
\vspace{3mm}
\ixnote{节选自9270 C12原生日志；客户端逐条重算与原汇总一致。完整源码、缓存交付及干净环境复验按实际范围验收。}
\end{frame}

% 11. The failed design exposes a real resource tradeoff.
\begin{frame}{成本、性能与取舍}
\ixclaim{只减少活动请求，会把生成阶段的竞争转移成首字前排队}
\small 固定16个客户端请求；仅把引擎活动容量从16降到12。\par
\vspace{2mm}
\begin{columns}[T]
\begin{column}{.48\textwidth}
\centering
\small 首字P95（s，目标$\leq$10）\par
\begin{tikzpicture}
\begin{axis}[ixaxis,width=6.7cm,height=3.4cm,
 xmin=.5,xmax=2.5,ymin=0,ymax=18,xtick={1,2},
 xticklabels={活动16,活动12},ytick={0,5,10,15}]
\addplot[ybar,bar width=22pt,draw=State,fill=State!12,nodes near coords]
 coordinates {(1,9.855908) (2,14.426440)};
\addplot[Pass,dashed,thick] coordinates {(.5,10)(2.5,10)};
\end{axis}
\end{tikzpicture}
\end{column}
\begin{column}{.48\textwidth}
\centering
\small 生成P95（ms/token，目标$\leq$40）\par
\begin{tikzpicture}
\begin{axis}[ixaxis,width=6.7cm,height=3.4cm,
 xmin=.5,xmax=2.5,ymin=0,ymax=60,xtick={1,2},
 xticklabels={活动16,活动12},ytick={0,20,40,60}]
\addplot[ybar,bar width=22pt,draw=Work,fill=Work!12,nodes near coords]
 coordinates {(1,48.784071) (2,43.719738)};
