\begin{frame}{结果与证据}
\begin{tikzpicture}[remember picture,overlay]
\begin{scope}[shift={(current page.north west)},x=1cm,y=-1cm]
\ixheader{12并发单轮通过，两项延迟同时达标}{12 concurrent requests meet both targets}
\node[anchor=north west,inner sep=0pt] at (.55,2.05) {
\begin{tikzpicture}
\begin{axis}[ixaxis,width=9cm,height=4.9cm,xmin=0,xmax=28,ymin=0,ymax=125,
 xtick={0,10,20},ytick={0,40,80,120},
 xlabel={\ixlang{首字P95（s）}{TTFT P95 (s)}},
 ylabel={\ixlang{生成P95（ms/token）}{TPOT P95 (ms/token)}}]
\path[fill=Pass!7] (axis cs:0,0) rectangle (axis cs:10,40);
\addplot[Pass,dashed,thick] coordinates {(0,40)(28,40)};
\addplot[Pass,dashed,thick] coordinates {(10,0)(10,125)};
\node[font=\fontsize{10}{12}\selectfont,text=Pass] at (axis cs:4.5,15) {\ixlang{双目标区}{Both met}};
\addplot[only marks,Pass,mark=*,mark size=3.2pt] coordinates {(9.499646,37.340162)};
\addplot[only marks,Fail,mark=x,mark size=4pt,thick] coordinates {(9.934084,51.702542) (23.694501,101.157387)};
\node[font=\fontsize{10}{12}\selectfont,text=Pass,anchor=north west] at (axis cs:10.5,34) {C12};
\node[font=\fontsize{10}{12}\selectfont,text=Fail,anchor=south west] at (axis cs:10.5,53) {C16};
\node[font=\fontsize{10}{12}\selectfont,text=Fail,anchor=south east] at (axis cs:25,105) {C32};
\end{axis}\end{tikzpicture}};
\node[value,text=Pass,font=\fontsize{30}{33}\selectfont] at (10.0,2.3) {\textbf{284.75}};
\node[toptext] at (10.0,3.65) {\ixlang{tok/s，12并发达标配置}{tok/s at the passing C12 load}};
\node[toptext,text width=4.9cm] at (10.0,4.55) {TTFT P95\quad 9.50s\\[2mm]TPOT P95\quad 37.34ms};
\node[takeaway,text width=4.8cm] at (10.0,6.1)
 {\ixlang{更高吞吐\\不等于延迟达标}{Higher throughput\\does not ensure low latency}};
\ixsource{同一9270版本；各128+8、冷8192/512、零错误。12/16同机，32另一同规格节点，KV随并发调整；16/32吞吐307.15/363.58。单轮，非稳定上限。}
 {Same build 9270; 128+8, cold 8192/512, zero errors. C12/16 share a node; C32 uses an equivalent node. KV scales with concurrency. C16/32: 307.15/363.58 tok/s. One run, not a stable limit.}
\end{scope}
\end{tikzpicture}
\end{frame}

