\newcommand{\ixlang}[2]{#1}
\tikzset{
 txt/.style={font=\fontsize{11}{14}\selectfont,text=Ink,align=left},
 sm/.style={font=\fontsize{10}{12}\selectfont,text=Ink,align=center},
 box/.style={sm,draw=Line,line width=.6pt,fill=white,inner sep=5pt},
 mechanism/.style={box,draw=Work,fill=Work!5},
 state/.style={box,draw=Blue,fill=Blue!5},
 flow/.style={-{Latex[length=1.6mm]},draw=Muted,line width=.8pt},
 feed/.style={flow,dashed,draw=Blue},
 token/.style={sm,draw=Line,minimum width=7mm,minimum height=7mm},
 toptext/.style={txt,anchor=north west},
 caption/.style={font=\fontsize{8}{10}\selectfont,text=Muted,align=left,anchor=north west},
 value/.style={font=\fontsize{33}{36}\selectfont,text=Ink,anchor=north west},
 takeaway/.style={font=\fontsize{12}{15}\selectfont,text=Ink,align=left,anchor=north west}}
\pgfplotsset{compat=1.18,
 ixaxis/.style={axis lines=left,axis line style={Line},
 ticklabel style={font=\fontsize{10}{12}\selectfont},
 label style={font=\fontsize{10}{12}\selectfont},
 xtick style={draw=none},ytick style={draw=none},
 ymajorgrids=true,grid style={Line!45},scaled ticks=false,
 nodes near coords style={font=\fontsize{10}{12}\selectfont,
 /pgf/number format/fixed,/pgf/number format/precision=1}}}
\newcommand{\ixheader}[2]{
 \node[anchor=north west,font=\fontsize{9}{11}\selectfont,text=Muted] at (.75,.32) {\insertframetitle};
 \node[anchor=north west,font=\fontsize{18}{21}\selectfont\bfseries,text=Ink,
 text width=14.5cm,align=left] at (.75,.92) {\ixlang{#1}{#2}};
 \draw[Line!60,line width=.4pt] (.75,8.65)--(15.25,8.65);
 \node[anchor=north west,font=\fontsize{7.5}{9}\selectfont,text=Muted] at (.75,8.72) {InferX\quad Track A};
 \node[anchor=north east,font=\fontsize{7.5}{9}\selectfont,text=Muted] at (15.25,8.72) {\insertframenumber\ / 12};
}
\newcommand{\ixsource}[2]{\node[caption,text width=14.5cm] at (.75,7.94) {\ixlang{#1}{#2}};}
\title{InferX}
\author{你说啥都队}
\date{2026-10-18}
\begin{document}

\begin{frame}{项目概述}
\begin{tikzpicture}[remember picture,overlay]
\begin{scope}[shift={(current page.north west)},x=1cm,y=-1cm]
\ixheader{InferX：一张卡，更多及时响应的请求}{InferX: More requests. One GPU.}
\node[toptext,text=Muted] at (.85,1.92) {Qwen3.8-27B\quad / \quad \ixlang{8k长输入}{8k-token inputs}\quad / \quad 1$\times$48GB RTX 4090};
\node[box,text width=2.0cm,minimum height=1.2cm] (req) at (2.0,3.75)
 {\ixlang{并发请求\\长输入}{Concurrent\\long inputs}};
\node[mechanism,text width=4.1cm,minimum height=1.45cm] (gpu) at (7.45,3.75)
 {\textbf{InferX / NInfer}\\\ixlang{INT4计算 + 并发状态 + 调度}{INT4 + request state + scheduling}};
\node[sm,text width=2.5cm] (ans) at (13.3,3.75)
 {\ixlang{及时出现首字\\持续生成回答}{Timely first token\\Continuous generation}};
\draw[flow] (req)--(gpu);
\draw[flow] (gpu)--(ans);
\node[value,text=Pass] at (.85,5.45) {\textbf{12}};
\node[toptext] at (.85,6.85) {\ixlang{并发，单轮满足两项延迟目标}{concurrent requests; both targets met}};
\node[value] at (8.4,5.45) {\textbf{284.75}};
\node[toptext] at (8.4,6.85) {\ixlang{tok/s，达标配置的总输出吞吐}{tok/s aggregate output at the passing load}};
\node[toptext,font=\fontsize{10}{12}\selectfont] at (.85,7.42)
 {\ixlang{你说啥都队\quad 陈文欣、张志雄、郭坤昌}{Wenxin Chen, Zhixiong Zhang, Kunchang Guo}};
\ixsource{性能版9270；128正式+8预热，冷8192/512，零错误，单轮结果。github.com/Yuer-yuan/InferX}
 {Performance build 9270; 128 measured + 8 warmup, cold 8192/512, zero errors, one run. github.com/Yuer-yuan/InferX}
\end{scope}
\end{tikzpicture}
\end{frame}

\begin{frame}{问题与目标}
\begin{tikzpicture}[remember picture,overlay]
\begin{scope}[shift={(current page.north west)},x=1cm,y=-1cm]
\ixheader{并发增加，吞吐饱和，等待上升}{Throughput saturates. Latency grows.}
\node[toptext] at (.95,2.0) {\ixlang{总输出吞吐（tok/s）}{Aggregate output (tok/s)}};
\node[toptext] at (8.5,2.0) {\ixlang{生成延迟P95（ms/token）}{TPOT P95 (ms/token)}};
\node[anchor=north west,inner sep=0pt] at (.7,2.55) {
\begin{tikzpicture}
\begin{axis}[ixaxis,width=7.0cm,height=3.8cm,xmin=.6,xmax=4.5,ymin=0,ymax=130,
 xtick={1,2,3,4},xticklabels={1,2,4,8},ytick={0,40,80,120},
 xlabel={\ixlang{客户端并发}{Client concurrency}}]
\addplot[Muted,thick,mark=*,nodes near coords] coordinates {(1,73.592962) (2,92.089488) (3,94.612183) (4,103.309039)};
\end{axis}\end{tikzpicture}};
\node[anchor=north west,inner sep=0pt] at (8.25,2.55) {
\begin{tikzpicture}
\begin{axis}[ixaxis,width=7.0cm,height=3.8cm,xmin=.6,xmax=4.5,ymin=0,ymax=110,
 xtick={1,2,3,4},xticklabels={1,2,4,8},ytick={0,40,80},
 xlabel={\ixlang{客户端并发}{Client concurrency}}]
\addplot[Blue,thick,mark=*,nodes near coords] coordinates {(1,9.009001) (2,22.506397) (3,45.929756) (4,90.659709)};
\addplot[Pass,dashed,thick] coordinates {(.6,40)(4.5,40)};
\node[font=\fontsize{9}{11}\selectfont,text=Pass,anchor=south east] at (axis cs:4.5,40) {40ms};
\end{axis}\end{tikzpicture}};
\node[takeaway] at (.85,6.92)
 {\textbf{\ixlang{成功标准：首字P95}{Targets: TTFT P95}} $\leq$ 10s\qquad \textbf{TPOT P95} $\leq$ 40ms};
\node[toptext,font=\fontsize{10}{12}\selectfont] at (.85,7.45)
 {\ixlang{首字计入排队和输入处理；生成延迟计入首字后的等待。}{TTFT includes queueing and prefill; TPOT includes waiting after the first token.}};
\ixsource{旧基线b604，同机单卡，冷8192/512，100正式+8预热；新版128+8，不计算跨协议加速比。}
 {Baseline b604: same node, one GPU, cold 8192/512, 100+8. New runs use 128+8; no cross-protocol speedup claim.}
\end{scope}
\end{tikzpicture}
\end{frame}

\begin{frame}{整体方案}
\begin{tikzpicture}[remember picture,overlay]
\begin{scope}[shift={(current page.north west)},x=1cm,y=-1cm]
\ixheader{同时减少执行开销与请求等待}{Optimize execution and waiting together}
\node[sm] (api) at (.95,3.65) {API};
\node[box,text width=1.1cm] (queue) at (2.65,3.65) {\ixlang{等待\\队列}{Request\\queue}};
\node[mechanism,text width=2.25cm] (sched) at (5.3,3.65) {\ixlang{调度器\\输入 / 生成}{Scheduler\\Prefill / decode}};
\draw[Line,line width=.7pt] (7.5,2.25) rectangle (12.15,6.35);
\node[toptext,font=\fontsize{10}{12}\selectfont,text=Muted] at (7.75,2.48) {1$\times$48GB RTX 4090};
\node[box,text width=3.55cm,minimum height=1.25cm] (exec) at (9.8,3.75)
 {\ixlang{分块输入处理\\INT4计算 / MTP验证}{Chunked prefill\\INT4 kernels / MTP verification}};
\node[state,text width=3.55cm,minimum height=.95cm] (state) at (9.8,5.6)
 {\ixlang{每请求独立状态\\KV / 递推状态 / 进度}{Per-request state\\KV / recurrent state / progress}};
\node[mechanism,text width=2.25cm] (weights) at (5.3,5.6)
 {\ixlang{离线校准\\4bit权重缓存}{Offline calibration\\4-bit weight cache}};
\node[sm,text width=1.65cm] (out) at (14.15,3.75) {\ixlang{流式\\回答}{Streamed\\responses}};
\draw[flow] (api)--(queue);
\draw[flow] (queue)--(sched);
\draw[flow] (sched)--(exec);
\draw[flow] (exec)--(out);
\draw[flow] (weights.east)--(7.1,5.6)--(7.1,4.4)--(exec.south west);
\draw[{Latex[length=1.3mm]}-{Latex[length=1.3mm]},draw=Blue,line width=.8pt] (exec.south)--(state.north);
\draw[feed] (state.south)--(9.8,6.75)--(3.65,6.75)--(3.65,4.45)--(sched.south west);
\node[sm,text=Blue,fill=white] at (5.4,6.75) {\ixlang{实际提交进度}{Committed progress}};
\node[toptext,text width=14.3cm,font=\fontsize{10}{12}\selectfont] at (.85,7.2)
 {\ixlang{NInfer便于直接修改C++/CUDA；上游MTP减少生成轮次，本组改造量化、批执行、状态与调度。}
 {NInfer exposes C++/CUDA execution. MTP is upstream; our work targets quantization, batching, state and scheduling.}};
\ixsource{部署：上下文65536，输入块2048，INT8 KV，MTP K3。实线：执行/数据；虚线：进度反馈。}
 {Deployment: context 65536, prefill chunks 2048, INT8 KV, MTP K3. Solid: execution/data. Dashed: progress feedback.}
\end{scope}
\end{tikzpicture}
\end{frame}

\begin{frame}{核心实现}
\begin{tikzpicture}[remember picture,overlay]
\begin{scope}[shift={(current page.north west)},x=1cm,y=-1cm]
\ixheader{让4bit真正进入矩阵计算}{INT4 computation, beyond compact weights}
\node[sm] (w) at (1.2,3.0) {\ixlang{模型权重\\离线}{Weights\\Offline}};
\node[sm] (x) at (1.2,5.25) {\ixlang{输入激活\\在线}{Activations\\Online}};
\node[mechanism,text width=2.5cm] (wq) at (4.05,3.0) {\ixlang{GPTQ校准\\4bit权重}{GPTQ calibration\\4-bit weights}};
\node[mechanism,text width=2.5cm] (aq) at (4.05,5.25) {\ixlang{动态量化\\4bit激活}{Dynamic quantization\\4-bit activations}};
\node[mechanism,text width=2.3cm,minimum height=1.25cm] (mma) at (7.75,4.1) {\ixlang{INT4点积\\矩阵指令}{INT4 dot products\\Matrix instructions}};
\node[box,text width=1.6cm,minimum height=.9cm] (rescale) at (11,4.1) {\ixlang{缩放\\累加}{Rescale\\Accumulate}};
\node[sm] (out) at (14.1,4.1) {\ixlang{BF16\\输出}{BF16\\output}};
\draw[flow] (w)--(wq);
\draw[flow] (x)--(aq);
\draw[flow] (wq.east)--(mma.north west);
\draw[flow] (aq.east)--(mma.south west);
\draw[flow] (mma)--(rescale);
\draw[flow] (rescale)--(out);
\draw[flow] (wq.north)--(4.05,2.15)--(11,2.15)--(rescale.north);
\node[sm,fill=white] at (7.9,2.15) {\ixlang{权重缩放值}{Weight scales}};
\draw[flow] (aq.south)--(4.05,6.1)--(11,6.1)--(rescale.south);
\node[sm,fill=white] at (7.9,6.1) {\ixlang{激活缩放值}{Activation scales}};
\node[takeaway,text width=14.3cm] at (.85,7.0)
 {\ixlang{64层、128个前馈矩阵 $\rightarrow$ 输入投影 $\rightarrow$ 输出投影}
 {64 layers / 128 FFN matrices $\rightarrow$ input $\rightarrow$ output projections}};
\ixsource{H512变换、G512分组，独立文本校准；其余算子/状态保留原格式，量化仍有误差。参考GPTQ/QuaRot/Atom。}
 {H512 transform, G512 groups, independent calibration text. Other operators/states retain their formats; quantization is lossy. GPTQ/QuaRot/Atom.}
\end{scope}
\end{tikzpicture}
\end{frame}

\begin{frame}{核心实现}
\begin{tikzpicture}[remember picture,overlay]
\begin{scope}[shift={(current page.north west)},x=1cm,y=-1cm]
\ixheader{扩展并发，先保证每份状态正确}{More requests need independent state}
\node[sm] at (4.2,2.2) {\ixlang{MTP提议3个候选}{MTP proposes three draft tokens}};
\node[sm] at (11.7,2.2) {\ixlang{按实际提交独立更新}{Independent state at commit}};
\node[sm] (a) at (1.05,3.45) {\ixlang{请求A}{Request A}};
\node[sm] (b) at (1.05,5.15) {\ixlang{请求B}{Request B}};
\node[token,fill=Work!10] (a1) at (3.1,3.45) {a1};
\node[token,fill=Work!10] at (4.25,3.45) {a2};
\node[token,dashed,text=Muted] at (5.4,3.45) {a3};
\node[token,fill=Work!10] (b1) at (3.1,5.15) {b1};
\node[token,dashed,text=Muted] at (4.25,5.15) {b2};
\node[token,dashed,text=Muted] at (5.4,5.15) {b3};
\node[box,text width=1.2cm] (va) at (7.35,3.45) {\ixlang{验证}{Verify}};
\node[box,text width=1.2cm] (vb) at (7.35,5.15) {\ixlang{验证}{Verify}};
\node[state,text width=4.0cm,minimum height=.9cm] (sa) at (11.7,3.45)
 {\ixlang{A：接受前2个候选\\更新自己的KV与递推状态}{A: accept two draft tokens\\Update own KV and recurrent state}};
\node[state,text width=4.0cm,minimum height=.9cm] (sb) at (11.7,5.15)
 {\ixlang{B：接受前1个候选\\更新自己的KV与递推状态}{B: accept one draft token\\Update own KV and recurrent state}};
\draw[flow] (a)--(a1);
\draw[flow] (b)--(b1);
\draw[flow] (5.9,3.45)--(va);
\draw[flow] (5.9,5.15)--(vb);
\draw[flow] (va)--(sa);
\draw[flow] (vb)--(sb);
\node[sm,text=Muted] at (4.25,6.2) {\ixlang{实框：接受；虚框：拒绝（示意）}{Solid: accepted. Dashed: rejected. Illustration only.}};
\node[takeaway,text width=14.3cm] at (.85,7.0)
 {\ixlang{16/32批执行：同时扩展槽位、回滚、工作区与CUDA Graph。}{16/32-way execution needs slots, rollback, workspace and CUDA Graph.}};
\ixsource{省略目标回退token，接受数不等于总提交数；每请求状态按实际提交推进。MTP来自上游，本组改造批执行及生命周期。}
 {Target fallback tokens omitted; accepted drafts are not total commits. State follows actual commits. MTP is upstream; batching/lifecycle are extended.}
\end{scope}
\end{tikzpicture}
\end{frame}

\begin{frame}{核心实现}
\begin{tikzpicture}[remember picture,overlay]
\begin{scope}[shift={(current page.north west)},x=1cm,y=-1cm]
\ixheader{按请求实际进度安排下一轮工作}{Schedule by each request's progress}
\node[toptext] at (.85,2.48) {\ixlang{8192-token新输入}{New 8192-token input}};
\foreach \i in {0,1,2,3}{
 \draw[Line,fill=Line!10] (4.4+\i*2.4,2.3) rectangle (6.7+\i*2.4,3.05);
 \node[sm] at (5.55+\i*2.4,2.675) {2048};
}
\node[toptext,text width=3.2cm] at (.85,4.2) {\ixlang{单卡执行顺序\\（机制示意）}{One GPU\\Illustrative schedule}};
\foreach \i in {0,1,2,3}{
 \draw[Line,fill=Line!10] (4.4+\i*2.4,4.15) rectangle (5.7+\i*2.4,4.95);
 \node[sm] at (5.05+\i*2.4,4.55) {\ixlang{输入}{PF}};
 \draw[Work,fill=Work!8] (5.8+\i*2.4,4.15) rectangle (6.75+\i*2.4,4.95);
 \node[sm,text=Work] at (6.275+\i*2.4,4.55) {\ixlang{生成}{Gen}};
}
\draw[flow] (9.15,3.05)--(9.15,4.05);
\node[sm,anchor=west] at (9.35,3.55) {\ixlang{块间重新调度}{Reschedule between chunks}};
\node[mechanism,text width=9.7cm] (budget) at (9.2,5.95)
 {\ixlang{根据各请求已提交token，估计剩余工作}{Estimate remaining work from each request's committed tokens}};
\draw[flow] (budget.north)--(9.2,4.95);
\node[takeaway,text width=14.3cm] at (.85,7.0)
 {\textbf{C16 TPOT P95: 48.78 $\rightarrow$ 45.74 ms}\quad
 \ixlang{降低6.23\%，仍未达标}{6.23\% lower; still above 40ms}};
\ixsource{2362→837f，同机同payload，K3/KV139264，128+8，冷8192/512，单轮。首字9.856→9.838s，吞吐311.77→315.73。时间块无耗时比例。}
 {2362→837f, same node/payload, K3/KV139264, 128+8, cold 8192/512, one run. TTFT 9.856→9.838s; tok/s 311.77→315.73. Widths are schematic.}
\end{scope}
\end{tikzpicture}
\end{frame}

