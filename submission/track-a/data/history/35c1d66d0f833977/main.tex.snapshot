\begin{column}{.47\textwidth}
\begin{itemize}
\item TTFT P95 $\leq 10$s。
\item TPOT P95 $\leq 40$ms。
\item 逐请求计算，再取线性P95：
\end{itemize}
\[\mathrm{TPOT}_i=\dfrac{\mathrm{E2E}_i-\mathrm{TTFT}_i}{512-1}\]
\small 客户端计时包含排队和网络；吞吐保留原phase分母。
\par\vspace{3mm}
\ixnote{后续扩展为128+8、K3，与旧ZIP分列。FP8框架参考另有后端、槽位和样本差异，不计算跨栈净加速。}
\end{column}
\end{columns}
\end{frame}

\begin{frame}{整体方案}
保留上游模型与 MTP，在调度、投影计算和状态接缝中实现优化。
\vspace{3mm}
\begin{tikzpicture}[x=1cm,y=1cm]
\node[font=\footnotesize,align=center] (req) at (.5,.6) {API请求\\8192 / 512};
\node[component,text width=1.5cm] (queue) at (2.6,.6) {准入队列};
\node[component,text width=2.1cm] (sched) at (5.4,.6) {完成预算调度\\chunk / 时限};
\node[component,text width=2.8cm,minimum height=2.3cm] (exec) at (9.5,.65) {};
\node[font=\scriptsize,anchor=south] at (exec.north) {原生执行 / Graph};
\node[font=\footnotesize,align=center] (pf) at (9.5,1.25) {Prefill / S4投影};
\node[font=\footnotesize,align=center] (dec) at (9.5,.05) {Decode / Verify\\MTP K3，B16/B32};
\node[font=\footnotesize] (out) at (12.6,.6) {响应};
\node[state,text width=3.9cm] (st) at (9.5,-1.25) {逐请求 KV / GDN 状态\\slot / bank / 提交数 / 回滚};
\node[component,text width=3.2cm] (cache) at (4,2.1) {离线：FP8 + GPTQ\\025 / 041 / 047缓存};
\draw[flow] (req)--(queue);
\draw[flow] (queue)--(sched);
\draw[flow] (sched.east)--(pf.west);
\draw[flow] (sched.east)--(dec.west);
\draw[flow] (pf.east)--(out);
\draw[flow] (dec.east)--(out);
\draw[flow] (cache.east)--(exec.north west) node[midway,above,font=\scriptsize]{加载权重};
\draw[{Latex[length=1.8mm]}-{Latex[length=1.8mm]},draw=State] (exec.south)--(st.north);
\draw[feedback] (st.west)-|(sched.south) node[pos=.3,below,font=\scriptsize]{提交进度反馈};
\end{tikzpicture}
\ixnote{实线：请求、执行、权重加载；双向蓝线：执行层读写状态；虚线：提交进度反馈。缓存是离线产物。}
\vspace{2mm}
\small NInfer提供紧凑权重与原生MTP；团队新增量化、批扩容和状态/调度接入。Norm与递推状态保留浮点语义。
\end{frame}

\begin{frame}{核心实现}
先定位热点，再扩大真实计算覆盖；端到端结果决定候选是否晋级。
\vspace{3mm}
\begin{columns}[T,onlytextwidth]
\begin{column}{.49\textwidth}
\small
\textbf{dense热点 $\rightarrow$ 旋转/GPTQ + S4 MMA}\par
025校准64层gate/up与down，共128矩阵；扩展041输入及047的47层GDN输出。保留scale、SiLU和残差。
\par\vspace{3mm}
\textbf{高批执行 $\rightarrow$ 状态与Graph共同扩容}\par
B16/B32验证slot、KV/GDN回滚及工作区；调度兼顾首token欠账和完成预算。能运行不等于延迟通过。
\par\vspace{3mm}
\textbf{状态开销 $\rightarrow$ GDN fold+record}\par
native生命周期2013条配对无差异；属补充数值证据。C32吞吐略升但尾延迟恶化，未晋级。
\end{column}
\begin{column}{.47\textwidth}
\begin{tikzpicture}
\begin{axis}[width=6.6cm,height=4cm,ybar,bar width=17pt,ymin=0,ymax=430,
 xtick={1,2,3},xticklabels={FFN S4,加输入,加输出},ylabel={输出 tok/s},
 title={u1 C32：累计版本历史},nodes near coords]
\addplot[fill=State!35,draw=State] coordinates {(1,305.910173) (2,352.410492) (3,363.576857)};
\end{axis}
\end{tikzpicture}
\ixnote{c3f482 / 40b3 / 9270；128+8、K3、冷8192/512。表示与覆盖同时变化，不归因单项优化；三轮C32均未通过。40b3仅有本地汇总。}
\end{column}
\end{columns}
\vspace{3mm}
\ixnote{上游：模型、NInfer基础引擎及MTP。团队：校准缓存、算子/路由、批扩容、状态/调度接入和证据核验。}
\end{frame}

