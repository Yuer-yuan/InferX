\node[takeaway] at (.85,6.92)
 {\textbf{\ixlang{成功标准：首字P95}{Targets: TTFT P95}} $\leq$ 10s\qquad \textbf{TPOT P95} $\leq$ 40ms};
\node[toptext,font=\fontsize{10}{12}\selectfont] at (.85,7.45)
 {\ixlang{首字计入排队和输入处理；生成延迟计入首字后的等待。}{TTFT includes queueing and prefill; TPOT includes waiting after the first token.}};
\ixsource{旧基线b604，同机单卡，冷8192/512，100正式+8预热；新版128+8，不计算跨协议加速比。}
 {Baseline b604: same node, one GPU, cold 8192/512, 100+8. New runs use 128+8; no cross-protocol speedup claim.}
\end{scope}
\end{tikzpicture}
\end{frame}

\begin{frame}{@@CHAPTER_3@@}
\begin{tikzpicture}[remember picture,overlay]
\begin{scope}[shift={(current page.north west)},x=1cm,y=-1cm]
\ixheader{同时减少执行开销与请求等待}{Optimize execution and waiting together}
@@FIG_ARCHITECTURE@@
\node[toptext,text width=14.3cm,font=\fontsize{10}{12}\selectfont] at (.85,7.2)
 {\ixlang{NInfer便于直接修改C++/CUDA；上游MTP减少生成轮次，本组改造量化、批执行、状态与调度。}
 {NInfer exposes CUDA execution. MTP is upstream; we extend kernels, batching, state and scheduling.}};
\ixsource{部署：上下文65536，输入块2048，INT8 KV，MTP K3。实线：执行/数据；虚线：进度反馈。}
 {Deployment: context 65536, prefill chunks 2048, INT8 KV, MTP K3. Solid: execution/data. Dashed: progress feedback.}
\end{scope}
\end{tikzpicture}
\end{frame}

\begin{frame}{@@CHAPTER_4@@}
\begin{tikzpicture}[remember picture,overlay]
\begin{scope}[shift={(current page.north west)},x=1cm,y=-1cm]
\ixheader{让4bit真正进入矩阵计算}{INT4 computation, beyond compact weights}
@@FIG_INT4@@
\node[takeaway,text width=14.3cm] at (.85,7.0)
 {\ixlang{64层、128个前馈矩阵 $\rightarrow$ 输入投影 $\rightarrow$ 输出投影}
 {64 layers / 128 FFN matrices $\rightarrow$ input $\rightarrow$ output projections}};
\ixsource{H512变换、G512分组，独立文本校准；其余算子/状态保留原格式，量化仍有误差。参考GPTQ/QuaRot/Atom。}
 {H512 transform, G512 groups, independent calibration text. Other operators/states retain their formats; quantization is lossy. GPTQ/QuaRot/Atom.}
\end{scope}
\end{tikzpicture}
\end{frame}

\begin{frame}{@@CHAPTER_4@@}
\begin{tikzpicture}[remember picture,overlay]
\begin{scope}[shift={(current page.north west)},x=1cm,y=-1cm]
\ixheader{扩展并发，先保证每份状态正确}{More requests need independent state}
@@FIG_STATE@@
\node[takeaway,text width=14.3cm] at (.85,7.0)
 {\ixlang{16/32批执行：同时扩展槽位、回滚、工作区与CUDA Graph。}{16/32-way execution needs slots, rollback, workspace and CUDA Graph.}};
\ixsource{省略目标回退token，接受数不等于总提交数；每请求状态按实际提交推进。MTP来自上游，本组改造批执行及生命周期。}
 {Target fallback tokens omitted; accepted drafts are not total commits. State follows actual commits. MTP is upstream; batching/lifecycle are extended.}
\end{scope}
\end{tikzpicture}
\end{frame}

\begin{frame}{@@CHAPTER_4@@}
\begin{tikzpicture}[remember picture,overlay]
\begin{scope}[shift={(current page.north west)},x=1cm,y=-1cm]
