\usepackage[UTF8,fontset=fandol]{ctex}
\usepackage{amsmath,tikz,pgfplots,sfmath}
\usetikzlibrary{arrows.meta,calc}
\setsansfont{Liberation Sans}
\setmonofont{Liberation Mono}
\setbeamertemplate{navigation symbols}{}
\setbeamertemplate{frametitle}{}
\setbeamertemplate{headline}{}
\setbeamertemplate{footline}{}
\setbeamersize{text margin left=7.5mm,text margin right=7.5mm}
\definecolor{Ink}{HTML}{20252C}
\definecolor{Muted}{HTML}{657180}
\definecolor{Line}{HTML}{CCD3DB}
\definecolor{Blue}{HTML}{32649A}
\definecolor{Accent}{HTML}{7E2635}
\definecolor{Work}{HTML}{7E2635}
\definecolor{Pass}{HTML}{287657}
\definecolor{Fail}{HTML}{B44B45}
\newcommand{\ixlang}[2]{#@@LANG_INDEX@@}
\tikzset{
 txt/.style={inner sep=0pt,font=\fontsize{11}{14}\selectfont,text=Ink,align=left},
 sm/.style={font=\fontsize{10}{12}\selectfont,text=Ink,align=center},
 box/.style={sm,draw=Line,line width=.6pt,fill=white,inner sep=5pt},
 mechanism/.style={box,draw=Work,fill=Work!5},
 state/.style={box,draw=Blue,fill=Blue!5},
 flow/.style={-{Latex[length=1.6mm]},draw=Muted,line width=.8pt},
 feed/.style={flow,dashed,draw=Blue},
 token/.style={sm,draw=Line,minimum width=7mm,minimum height=7mm},
 toptext/.style={txt,anchor=north west},
 caption/.style={inner sep=0pt,font=\fontsize{8}{10}\selectfont,text=Muted,align=left,anchor=north west},
 value/.style={font=\fontsize{33}{36}\selectfont,text=Ink,anchor=north west},
 takeaway/.style={font=\fontsize{12}{15}\selectfont,text=Ink,align=left,anchor=north west}}
\pgfplotsset{compat=1.18,
 ixaxis/.style={axis lines=left,axis line style={Line},
 ticklabel style={font=\fontsize{10}{12}\selectfont},
 label style={font=\fontsize{10}{12}\selectfont},
 xtick style={draw=none},ytick style={draw=none},
 ymajorgrids=true,grid style={Line!45},scaled ticks=false,
 nodes near coords style={font=\fontsize{10}{12}\selectfont,
 /pgf/number format/fixed,/pgf/number format/precision=1}}}
\newcommand{\ixheader}[2]{
 \fill[Accent] (0,0) rectangle (16,.65);
 \node[anchor=north west,inner sep=0pt,font=\fontsize{9}{11}\selectfont,text=white] at (.75,.18) {\insertframetitle};
 \node[anchor=north west,font=\fontsize{18}{21}\selectfont\bfseries,text=Ink,
 text width=14.5cm,align=left,inner sep=0pt] at (.75,.98) {\ixlang{#1}{#2}};
 \draw[Line!60,line width=.4pt] (.75,8.52)--(15.25,8.52);
 \node[anchor=south west,inner sep=0pt,font=\fontsize{7.5}{9}\selectfont,text=Muted] at (.75,8.88) {InferX\quad Track A};
 \node[anchor=south east,inner sep=0pt,font=\fontsize{7.5}{9}\selectfont,text=Muted] at (15.25,8.88) {\insertframenumber\ / 13};
}
\newcommand{\ixsource}[2]{\node[caption,text width=14.5cm] at (.75,7.78) {\ixlang{#1}{#2}};}
\title{InferX}
\author{@@TEAM@@}
\date{@@DATE_SHORT@@}
