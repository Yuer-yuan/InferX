\node[toptext] at (8.5,2.0) {\ixlang{生成延迟P95（ms/token）}{TPOT P95 (ms/token)}};
\node[anchor=north west,inner sep=0pt] at (.7,2.55) {
\begin{tikzpicture}
\begin{axis}[ixaxis,width=7.0cm,height=3.8cm,xmin=.6,xmax=4.5,ymin=0,ymax=130,
 xtick={1,2,3,4},xticklabels={1,2,4,8},ytick={0,40,80,120},
