+GenerationRequest parse_completion_request(const Json& body, const RequestLimits& limits,
+                                           const std::string& served_model) {
+    require_object(body);
+    GenerationRequest out;
+    out.raw_completion = true;
+    out.model = served_model;
+    if (body.contains("model")) {
+        if (!body.at("model").is_string() || body.at("model").get<std::string>() != served_model) {
+            bad_request("model must match the served model id", "model");
+        }
+    }
+    if (!body.contains("prompt")) { bad_request("prompt is required", "prompt"); }
+    const Json& prompt = body.at("prompt");
+    if (prompt.is_string()) {
+        out.prompt_text = prompt.get<std::string>();
+        if (out.prompt_text.empty()) { bad_request("prompt must not be empty", "prompt"); }
+    } else if (prompt.is_array() && !prompt.empty()) {
+        out.prompt_token_ids.reserve(prompt.size());
+        for (const Json& token : prompt) {
+            if (!token.is_number_integer() ||
+                (token.is_number_unsigned() && token.get<std::uint64_t>() >
+                    static_cast<std::uint64_t>(std::numeric_limits<std::int32_t>::max())) ||
+                (!token.is_number_unsigned() && (token.get<std::int64_t>() < 0 ||
+                    token.get<std::int64_t>() > std::numeric_limits<std::int32_t>::max()))) {
+                bad_request("prompt must be a flat array of nonnegative integer token IDs", "prompt");
+            }
+            out.prompt_token_ids.push_back(token.get<std::int32_t>());
+        }
+        // Vocabulary membership is checked by Engine::prepare_tokens against the artifact.
+    } else {
+        bad_request("prompt must be a nonempty string or flat integer token-ID array", "prompt");
+    }
+    for (const char* key : {"echo", "logprobs", "suffix", "best_of", "tools", "tool_choice",
+                            "functions", "function_call", "messages", "response_format",
+                            "logit_bias", "chat_template_kwargs", "enable_thinking",
+                            "reasoning_effort", "preserve_thinking"}) {
+        if (body.contains(key)) { bad_request(std::string(key) + " is not supported", key); }
+    }
+    for (const char* key : {"stream", "ignore_eos"}) {
+        if (body.contains(key) && !body.at(key).is_boolean()) {
+            bad_request(std::string(key) + " must be a boolean", key);
+        }
+    }
+    if (body.contains("cache_salt") && !body.at("cache_salt").is_string()) {
+        bad_request("cache_salt must be a string", "cache_salt");
+    }
+    // All raw completions disable prefix identity/reuse. Salt is type-checked only;
+    // this conservative isolation does not promise salt-specific cache reuse.
+    out.stream = get_bool(body, "stream", false);
+    out.ignore_eos = get_bool(body, "ignore_eos", false);
+    if (body.contains("stream_options")) {
+        if (!body.at("stream_options").is_object()) {
+            bad_request("stream_options must be an object", "stream_options");
+        }
+        const Json& options = body.at("stream_options");
+        if (options.contains("include_usage") && !options.at("include_usage").is_boolean()) {
+            bad_request("include_usage must be a boolean", "include_usage");
+        }
+        out.include_usage = get_bool(options, "include_usage", false);
+    }
+    for (const char* key : {"n", "max_tokens", "temperature", "top_p", "top_k",
+                            "presence_penalty", "frequency_penalty", "seed"}) {
+        if (body.contains(key) && body.at(key).is_null()) {
+            bad_request(std::string(key) + " must not be null", key);
+        }
+    }
+    parse_sampling(body, out);
+    parse_stop(body, out);
+    out.max_tokens = limits.default_max_tokens;
+    if (const auto budget = get_int(body, "max_tokens")) {
+        if (*budget <= 0) { bad_request("max_tokens must be positive", "max_tokens"); }
+        out.max_tokens = *budget;
+        out.max_tokens_set = true;
+    }
+    return out;
+}
