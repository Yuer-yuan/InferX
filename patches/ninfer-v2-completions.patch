+    return Json{{"id", id}, {"object", "text_completion"}, {"created", created}, {"model", model},
+                {"choices", Json::array({Json{{"index", 0}, {"text", text}, {"logprobs", nullptr},
+                                            {"finish_reason", finish_reason}}})},
